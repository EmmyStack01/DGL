<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us | Dan-Gracious Land Nursery & Primary School</title>
  <meta name="description" content="Learn about Dan-Gracious Land Nursery & Primary School in Idimu, Lagos. Discover our educational values, school environment, and commitment to every child's growth." />

  <meta property="og:title" content="About Us - Dan-Gracious Land Nursery & Primary School" />
  <meta property="og:description" content="More than a school. A place to grow. Learn about our philosophy, environment, and community at DGL." />
  <meta property="og:type" content="website" />

  <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Dan-Gracious Land Nursery & Primary School",
    "alternateName": "DGL",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "27, Asunbe Street",
      "addressLocality": "Idimu",
      "addressRegion": "Lagos",
      "addressCountry": "NG"
    },
    "url": "https://emmystack01.com"
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* -------------------------------------------------------------------------- */
    /* 1. DESIGN SYSTEM — TOKENS SHARED WITH THE HOMEPAGE                        */
    /* -------------------------------------------------------------------------- */
    :root {
      --color-navy: #0E2154;
      --color-navy-deep: #081533;
      --color-navy-soft: #1C3576;
      --color-cream: #FFF9EC;
      --color-cream-card: #FFFFFF;
      --color-gold: #FFC72C;
      --color-gold-deep: #F2A900;
      --color-gold-light: #FFF1C2;
      --color-orange: #F0640F;
      --color-orange-hover: #D4530A;
      --color-green: #2E9E4F;
      --color-blue: #1F5FD1;
      --color-purple: #6B3FA0;
      --color-red: #C81E2C;
      --color-text-dark: #101B3D;
      --color-text-muted: #5B6280;
      --color-white: #FFFFFF;
      --color-surface-soft: #F4EFE0;
      --color-border: #E7DFC8;

      --font-display: 'Poppins', -apple-system, sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Inter', -apple-system, sans-serif;

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --radius-full: 9999px;

      --shadow-sm: 0 4px 10px -2px rgba(14, 33, 84, 0.10);
      --shadow-md: 0 14px 28px -8px rgba(14, 33, 84, 0.18);
      --shadow-lg: 0 30px 60px -16px rgba(14, 33, 84, 0.30);

      --container-max: 1240px;
      --header-height: 84px;
    }

    /* -------------------------------------------------------------------------- */
    /* 2. RESET & BASE                                                           */
    /* -------------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: var(--font-body);
      background-color: var(--color-cream);
      color: var(--color-text-dark);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; font-size: inherit; cursor: pointer; border: none; background: none; }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1.15;
      color: var(--color-navy);
      letter-spacing: -0.01em;
    }

    .section-padding { padding: 4rem 0; }
    .text-center { text-align: center; }

    .section-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.15rem;
      background: var(--color-orange);
      color: var(--color-white);
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-radius: var(--radius-full);
      margin-bottom: 1rem;
      box-shadow: var(--shadow-sm);
    }
    .section-tag.tag-blue { background: var(--color-blue); }
    .section-tag.tag-purple { background: var(--color-purple); }
    .section-tag.tag-green { background: var(--color-green); }

    /* -------------------------------------------------------------------------- */
    /* 3. BUTTONS                                                                 */
    /* -------------------------------------------------------------------------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.9rem 2.1rem;
      font-weight: 800;
      font-size: 1rem;
      border-radius: var(--radius-full);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      text-align: center;
      min-height: 52px;
    }

    .btn-primary {
      background-color: var(--color-orange);
      color: var(--color-white);
      box-shadow: 0 10px 22px -6px rgba(240, 100, 15, 0.5);
    }
    .btn-primary:hover {
      background-color: var(--color-orange-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 26px -6px rgba(240, 100, 15, 0.55);
    }

    .btn-secondary {
      background-color: var(--color-navy);
      color: var(--color-white);
      box-shadow: 0 10px 20px -5px rgba(10, 15, 29, 0.3);
    }
    .btn-secondary:hover {
      background-color: var(--color-navy-soft);
      transform: translateY(-3px);
      box-shadow: 0 14px 24px -4px rgba(10, 15, 29, 0.4);
    }

    .btn-secondary2 {
      background-color: var(--color-white);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(0,0,0,0.15);
    }
    .btn-secondary2:hover { transform: translateY(-3px); }

    .btn-outline {
      border: 2.5px solid var(--color-gold);
      color: var(--color-navy);
      background: var(--color-white);
    }
    .btn-outline:hover {
      background-color: var(--color-gold);
      color: var(--color-navy);
      transform: translateY(-3px);
    }

    .btn-gold {
      background-color: var(--color-gold);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(255, 199, 44, 0.55);
    }
    .btn-gold:hover {
      background-color: var(--color-gold-deep);
      transform: translateY(-3px);
    }

    /* Level-color ribbon strip — echoes the flyer's Creche/Nursery/Primary/Secondary bars */
    .level-stripe { display: flex; height: 7px; width: 100%; }
    .level-stripe span { flex: 1; }
    .level-stripe .s-orange { background: var(--color-orange); }
    .level-stripe .s-green { background: var(--color-green); }
    .level-stripe .s-blue { background: var(--color-blue); }
    .level-stripe .s-purple { background: var(--color-purple); }

    /* -------------------------------------------------------------------------- */
    /* 4. HEADER & NAVIGATION                                                     */
    /* -------------------------------------------------------------------------- */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background-color: var(--color-navy);
      height: var(--header-height);
      display: flex;
      align-items: center;
      box-shadow: 0 6px 18px -8px rgba(8, 21, 51, 0.45);
    }

    .header .container { display: flex; align-items: center; justify-content: space-between; }

    .brand { display: flex; align-items: center; gap: 0.85rem; }

    .brand-badge { width: auto; height: 60px; display: flex; align-items: center; justify-content: center; }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.05rem;
      line-height: 1;
      color: var(--color-white);
      letter-spacing: 0.01em;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--color-gold-light);
      font-weight: 600;
      display: block;
      margin-top: 3px;
    }

    .nav-links { display: flex; align-items: center; gap: 2.25rem; list-style: none; }
    .nav-links a { font-weight: 700; font-size: 0.92rem; color: var(--color-white); transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--color-gold); }

    .mobile-menu-btn { display: none; flex-direction: column; gap: 6px; padding: 0.5rem; }
    .mobile-menu-btn span { width: 26px; height: 2.5px; background-color: var(--color-gold); border-radius: 4px; transition: all 0.3s ease; }

    /* -------------------------------------------------------------------------- */
    /* 5. BREADCRUMBS                                                            */
    /* -------------------------------------------------------------------------- */
    .breadcrumbs-bar { padding: 1.25rem 0 0.5rem 0; background: var(--color-cream); }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-muted);
      list-style: none;
    }

    .breadcrumbs a { color: var(--color-navy); }
    .breadcrumbs a:hover { color: var(--color-orange); }
    .breadcrumbs li[aria-current] { color: var(--color-orange); font-weight: 800; }

    /* -------------------------------------------------------------------------- */
    /* 6. HERO — angled navy panel + full-bleed photo (matches homepage hero)    */
    /* -------------------------------------------------------------------------- */
    .hero-about { position: relative; padding: 0 0 5rem 0; background: var(--color-cream); }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
      min-height: 420px;
    }

    .hero-content {
      background: var(--color-navy);
      background-image:
        radial-gradient(circle at 85% 15%, rgba(255, 199, 44, 0.12), transparent 55%),
        linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
      color: var(--color-white);
      padding: 4rem 3.5rem 4rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);
      position: relative;
    }

    .hero-content > * { max-width: 560px; }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background-color: var(--color-gold);
      color: var(--color-navy);
      padding: 0.45rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
      width: fit-content;
    }

    .hero-heading {
      font-size: clamp(2.25rem, 4.5vw, 3.25rem);
      margin-bottom: 1.25rem;
      line-height: 1.12;
      color: var(--color-white);
      font-weight: 900;
    }

    .hero-heading span { color: var(--color-gold); }

    .hero-subtext {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.78);
      max-width: 500px;
    }

    .hero-media { position: relative; height: 100%; }

    .hero-image-frame { position: relative; width: 100%; height: 100%; min-height: 340px; overflow: hidden; }

    .hero-img-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 60% 45%;
      display: block;
      border-left: 7px solid var(--color-gold);
      box-shadow: var(--shadow-lg);
    }

    /* -------------------------------------------------------------------------- */
    /* 7. INTRODUCTION                                                            */
    /* -------------------------------------------------------------------------- */
    .intro-block {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 3rem;
      margin-bottom: 4rem;
      box-shadow: var(--shadow-sm);
      border-top: 6px solid var(--color-gold);
    }

    .intro-block h2 { font-size: 2rem; margin-bottom: 1rem; }
    .intro-block p { font-size: 1.05rem; color: var(--color-text-muted); margin-bottom: 1rem; max-width: 800px; }
    .intro-block p:last-child { margin-bottom: 0; }

    /* -------------------------------------------------------------------------- */
    /* 8. OUR STORY                                                               */
    /* -------------------------------------------------------------------------- */
    .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; align-items: center; margin-bottom: 5rem; }

    .story-content h2 { font-size: 2.25rem; margin-bottom: 1rem; }
    .story-content p { color: var(--color-text-muted); margin-bottom: 1rem; font-size: 0.98rem; line-height: 1.7; }

    .story-card {
      background: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 2.5rem 2rem;
      text-align: center;
      box-shadow: var(--shadow-md);
      border-left: 8px solid var(--color-orange);
    }

    .story-card .story-icon {
      width: 64px;
      height: 64px;
      margin: 0 auto 1rem auto;
      background: var(--color-navy);
      color: var(--color-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
      box-shadow: var(--shadow-sm);
    }

    .story-card h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
    .story-card p { font-size: 0.92rem; color: var(--color-text-muted); }

    /* -------------------------------------------------------------------------- */
    /* 9. WHAT WE BELIEVE (VALUES)                                                */
    /* -------------------------------------------------------------------------- */
    .section-title-wrap { max-width: 600px; margin: 0 auto 3rem auto; text-align: center; }
    .section-title-wrap h2 { font-size: clamp(2rem, 4vw, 2.5rem); margin-bottom: 0.5rem; font-weight: 900; }
    .section-title-wrap p { font-size: 1.05rem; color: var(--color-text-muted); }

    .values-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.5rem; margin-bottom: 5rem; }

    .value-card {
      background: var(--color-white);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      box-shadow: var(--shadow-sm);
      position: relative;
      border-top: 6px solid var(--color-orange);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .value-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }

    .value-card:nth-child(1) { border-top-color: var(--color-orange); }
    .value-card:nth-child(2) { border-top-color: var(--color-green); }
    .value-card:nth-child(3) { border-top-color: var(--color-purple); }
    .value-card:nth-child(4) { border-top-color: var(--color-gold); }

    .value-card h3 { font-size: 1.25rem; margin-top: 0.5rem; margin-bottom: 0.5rem; }
    .value-card p { font-size: 0.9rem; color: var(--color-text-muted); }

    /* -------------------------------------------------------------------------- */
    /* 10. EVERY CHILD MATTERS — navy card like the location/heart panels        */
    /* -------------------------------------------------------------------------- */
    .child-centre-section {
      background: var(--color-navy);
      background-image: radial-gradient(circle at 10% 90%, rgba(255,199,44,0.10), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.75rem;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
      position: relative;
      overflow: hidden;
    }

    .child-centre-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }

    .child-centre-content h2 { color: var(--color-white); font-size: 2.25rem; margin-bottom: 1rem; }
    .child-centre-content p { color: rgba(255, 255, 255, 0.82); font-size: 1.05rem; line-height: 1.7; }

    .child-centre-media {
      background: rgba(255,255,255,0.06);
      border: 2px dashed rgba(255, 199, 44, 0.35);
      border-radius: var(--radius-md);
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .child-centre-media p { font-size: 1.05rem; color: var(--color-gold); font-weight: 700; margin: 0; }

    /* -------------------------------------------------------------------------- */
    /* 11. LEARNING BEYOND THE CLASSROOM — flyer-style colour bar cards          */
    /* -------------------------------------------------------------------------- */
    .learning-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin-bottom: 5rem; }

    .learning-card {
      background: var(--color-white);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: flex-start;
      gap: 1.1rem;
      border-left: 8px solid var(--color-orange);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .learning-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }

    .learning-card:nth-of-type(1) { border-left-color: var(--color-orange); }
    .learning-card:nth-of-type(2) { border-left-color: var(--color-green); }
    .learning-card:nth-of-type(3) { border-left-color: var(--color-blue); }
    .learning-card:nth-of-type(4) { border-left-color: var(--color-purple); }

    .learning-icon {
      width: 50px;
      height: 50px;
      flex-shrink: 0;
      background: var(--color-navy);
      color: var(--color-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      box-shadow: var(--shadow-sm);
    }

    .learning-card h3 { font-size: 1.1rem; margin-bottom: 0.4rem; color: var(--color-navy); }
    .learning-card p { font-size: 0.9rem; color: var(--color-text-muted); }

    /* -------------------------------------------------------------------------- */
    /* 12. COLLAGE STRIP — 4-photo strip like the homepage "heart" panel         */
    /* -------------------------------------------------------------------------- */
    .collage-strip {
      background: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem;
      margin-bottom: 5rem;
      text-align: center;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--color-border);
    }

    .collage-strip h2 { font-size: clamp(2rem, 4vw, 2.5rem); }
    .collage-strip .collage-sub { color: var(--color-text-muted); margin-top: 0.5rem; font-size: 1.05rem; }

    .collage-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.1rem; margin: 2.25rem 0; }

    .collage-item {
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease;
    }
    .collage-item:hover { transform: translateY(-5px); }

    .collage-photo {
      height: 118px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
    }

    .collage-item:nth-child(1) .collage-photo { background: linear-gradient(150deg, #FFD98A, var(--color-orange)); }
    .collage-item:nth-child(2) .collage-photo { background: linear-gradient(150deg, #9BE6B0, var(--color-green)); }
    .collage-item:nth-child(3) .collage-photo { background: linear-gradient(150deg, #A9C4FF, var(--color-blue)); }
    .collage-item:nth-child(4) .collage-photo { background: linear-gradient(150deg, #D3B6F2, var(--color-purple)); }

    .collage-label {
      background: var(--color-navy);
      color: var(--color-white);
      text-align: center;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.55rem 0.5rem;
    }

    /* -------------------------------------------------------------------------- */
    /* 13. CELEBRATE PROGRESS                                                     */
    /* -------------------------------------------------------------------------- */
    .celebrate-parents-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; margin-bottom: 5rem; }

    .info-card-block {
      background: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 2.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: var(--shadow-md);
      border-left: 8px solid var(--color-blue);
    }

    .info-card-block h3 { font-size: 1.6rem; margin-bottom: 0.75rem; }
    .info-card-block p { color: var(--color-text-muted); font-size: 0.98rem; margin-bottom: 1.5rem; max-width: 640px; }

    /* -------------------------------------------------------------------------- */
    /* 14. SCHOOL ENVIRONMENT                                                     */
    /* -------------------------------------------------------------------------- */
    .environment-section { margin-bottom: 5rem; }

    .env-photo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }

    .env-photo-card {
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      border-top: 6px solid var(--color-gold);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .env-photo-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
    .env-photo-card:nth-child(2) { border-top-color: var(--color-orange); }
    .env-photo-card:nth-child(3) { border-top-color: var(--color-blue); }

    .env-photo-visual {
      height: 170px;
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-navy);
      font-weight: 700;
      text-align: center;
      padding: 1rem;
    }

    .env-photo-content { padding: 1.25rem 1.5rem; background: var(--color-white); }
    .env-photo-content h3 { font-size: 1rem; }

    /* -------------------------------------------------------------------------- */
    /* 15. LEADERSHIP PREVIEW — bold orange CTA banner                           */
    /* -------------------------------------------------------------------------- */
    .leadership-preview {
      background: var(--color-orange);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,255,255,0.14), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2rem;
      text-align: center;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
    }

    .leadership-preview h2 { color: var(--color-white); font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
    .leadership-preview p { font-size: 1.1rem; color: rgba(255, 255, 255, 0.92); margin-bottom: 1.75rem; max-width: 560px; margin-left: auto; margin-right: auto; }

    /* -------------------------------------------------------------------------- */
    /* 16. FOOTER                                                                 */
    /* -------------------------------------------------------------------------- */
    .footer {
      background-color: var(--color-navy-deep);
      color: var(--color-white);
      padding: 5rem 0 2.5rem 0;
