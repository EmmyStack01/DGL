---
export const prerender = true;

import { createReader } from '@keystatic/core/reader';
import keystaticConfig, { CLASS_LEVEL_OPTIONS } from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const siteSettings = await reader.singletons.siteSettings.read();
const pupilsPageData = await reader.singletons.pupilsPage.read();

// See index.astro for why this fallback exists: siteSettings is null
// until the Site Settings singleton has been saved at least once in
// Keystatic's admin UI. Same reasoning applies to pupilsPageData below.
const phoneSupport = siteSettings?.phoneSupport ?? '+2348000000000';
const whatsAppChannelLink = siteSettings?.whatsAppChannelLink ?? 'https://wa.me/';

const currentSession = pupilsPageData?.currentSession ?? '2026/2027';
const awardsSession = pupilsPageData?.awardsSession ?? '2025/2026';

// "Find Your Class" — group classPhotos roster entries by classLevel so
// each of the 10 fixed class sections can render however many photos an
// editor has added for that class (0, 1, or several), instead of the old
// hardcoded one-block-per-class markup.
const classPhotos = pupilsPageData?.classPhotos ?? [];
const classPhotosByLevel = Object.fromEntries(
  CLASS_LEVEL_OPTIONS.map((c) => [c.value, classPhotos.filter((p) => p.classLevel === c.value)])
);

// "Celebrating Our Pupils" — badge icon per award title, matched against
// the exact option labels defined in keystatic.config.ts's awardTitle
// select field.
const AWARD_BADGE_ICON = {
  'Overall Best': '🏆',
  '1st Position': '🥇',
  '2nd Position': '🥈',
  '3rd Position': '🥉',
  'Best in Mathematics': '⭐',
  'Best in English': '⭐',
};

function slugify(str) {
  return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

// Card ids are built from content (class + award + pupil name), not array
// position, so a shared link (?/#award-...) keeps working even if an
// editor reorders or adds entries later. A running per-slug counter only
// kicks in for the rare case of two identical class+award+name entries.
const seenSlugs = new Map();
const achievementCards = (pupilsPageData?.celebratedPupils ?? []).map((p) => {
  const classLabel = CLASS_LEVEL_OPTIONS.find((c) => c.value === p.classLevel)?.label ?? p.classLevel;
  const baseSlug = `award-${p.classLevel}-${slugify(p.awardTitle)}-${slugify(p.pupilName)}`;
  const count = seenSlugs.get(baseSlug) ?? 0;
  seenSlugs.set(baseSlug, count + 1);
  const id = count === 0 ? baseSlug : `${baseSlug}-${count}`;
  return {
    id,
    classLevel: p.classLevel,
    classLabel,
    awardTitle: p.awardTitle,
    icon: AWARD_BADGE_ICON[p.awardTitle] ?? '⭐',
    pupilName: p.pupilName,
  };
});
