<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Meet Our Pupils & Achievements | Dan-Gracious Land Nursery & Primary School</title>
  <meta name="description" content="Discover class groups and celebrate student achievements at Dan-Gracious Land Nursery & Primary School in Idimu, Lagos." />
  
  <meta property="og:title" content="Dan-Gracious Land Pupils & Achievements" />
  <meta property="og:description" content="Celebrating the bright minds and achievements of DGL pupils." />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">

    <style>
    /* -------------------------------------------------------------------------- */
    /* 1. DESIGN SYSTEM — TOKENS SHARED WITH THE HOMEPAGE                        */
    /* -------------------------------------------------------------------------- */
    :root {
      --color-navy: #0E2154;
      --color-navy-deep: #081533;
      --color-navy-soft: #1C3576;
      --color-cream: #FFF9EC;
      --color-cream-card: #FFFFFF;
      --color-gold: #FFC72C;
      --color-gold-deep: #F2A900;
      --color-gold-light: #FFF1C2;
      --color-orange: #F0640F;
      --color-orange-hover: #D4530A;
      --color-green: #2E9E4F;
      --color-blue: #1F5FD1;
      --color-purple: #6B3FA0;
      --color-red: #C81E2C;
      --color-text-dark: #101B3D;
      --color-text-muted: #5B6280;
      --color-white: #FFFFFF;
      --color-surface-soft: #F4EFE0;
      --color-border: #E7DFC8;

      --font-display: 'Poppins', -apple-system, sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Inter', -apple-system, sans-serif;

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --radius-full: 9999px;

      --shadow-sm: 0 4px 10px -2px rgba(14, 33, 84, 0.10);
      --shadow-md: 0 14px 28px -8px rgba(14, 33, 84, 0.18);
      --shadow-lg: 0 30px 60px -16px rgba(14, 33, 84, 0.30);

      --container-max: 1240px;
      --header-height: 84px;
    }

    /* -------------------------------------------------------------------------- */
    /* 2. RESET & BASE                                                           */
    /* -------------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: var(--font-body);
      background-color: var(--color-cream);
      color: var(--color-text-dark);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1.15;
      color: var(--color-navy);
      letter-spacing: -0.01em;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.9rem 2.1rem;
      font-weight: 800;
      font-size: 1rem;
      border-radius: var(--radius-full);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      text-align: center;
      min-height: 52px;
    }

    .btn-primary {
      background-color: var(--color-orange);
      color: var(--color-white);
      box-shadow: 0 10px 22px -6px rgba(240, 100, 15, 0.5);
    }
    .btn-primary:hover {
      background-color: var(--color-orange-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 26px -6px rgba(240, 100, 15, 0.55);
    }

    .btn-secondary2 {
      background-color: var(--color-white);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(0,0,0,0.15);
    }
    .btn-secondary2:hover { transform: translateY(-3px); }

    .btn-outline {
      border: 2.5px solid var(--color-gold);
      color: var(--color-navy);
      background: var(--color-white);
    }
    .btn-outline:hover {
      background-color: var(--color-gold);
      color: var(--color-navy);
      transform: translateY(-3px);
    }

    .btn-gold {
      background-color: var(--color-gold);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(255, 199, 44, 0.55);
    }
    .btn-gold:hover {
      background-color: var(--color-gold-deep);
      transform: translateY(-3px);
    }

    .btn-share {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--color-white);
      border: 1.5px solid rgba(255, 255, 255, 0.3);
      padding: 0.5rem 1rem;
      font-size: 0.8rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      margin-top: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.2s;
      min-height: unset;
    }

    .btn-share:hover {
      background-color: var(--color-gold);
      color: var(--color-navy);
      border-color: var(--color-gold);
    }

    /* Level-color ribbon strip — echoes the flyer's Creche/Nursery/Primary/Secondary bars */
    .level-stripe { display: flex; height: 7px; width: 100%; }
    .level-stripe span { flex: 1; }
    .level-stripe .s-orange { background: var(--color-orange); }
    .level-stripe .s-green { background: var(--color-green); }
    .level-stripe .s-blue { background: var(--color-blue); }
    .level-stripe .s-purple { background: var(--color-purple); }

    /* -------------------------------------------------------------------------- */
    /* 3. HEADER & NAVIGATION                                                    */
    /* -------------------------------------------------------------------------- */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background-color: var(--color-navy);
      height: var(--header-height);
      display: flex;
      align-items: center;
      box-shadow: 0 6px 18px -8px rgba(8, 21, 51, 0.45);
    }

    .header .container { display: flex; align-items: center; justify-content: space-between; }

    .brand { display: flex; align-items: center; gap: 0.85rem; }

    .brand-badge { width: auto; height: 60px; display: flex; align-items: center; justify-content: center; }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.05rem;
      line-height: 1;
      color: var(--color-white);
      letter-spacing: 0.01em;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--color-gold-light);
      font-weight: 600;
      display: block;
      margin-top: 3px;
    }

    .nav-links { display: flex; align-items: center; gap: 2.25rem; list-style: none; }
    .nav-links a { font-weight: 700; font-size: 0.92rem; color: var(--color-white); transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--color-gold); }

    .mobile-menu-btn { display: none; flex-direction: column; gap: 6px; padding: 0.5rem; }
    .mobile-menu-btn span { width: 26px; height: 2.5px; background-color: var(--color-gold); border-radius: 4px; transition: all 0.3s ease; }

    /* -------------------------------------------------------------------------- */
    /* 4. BREADCRUMBS & HERO                                                     */
    /* -------------------------------------------------------------------------- */
    .breadcrumbs-bar { padding: 1.25rem 0 0.5rem 0; background: var(--color-cream); }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-muted);
      list-style: none;
    }

    .breadcrumbs a { color: var(--color-navy); }
    .breadcrumbs a:hover { color: var(--color-orange); }
    .breadcrumbs li[aria-current] { color: var(--color-orange); font-weight: 800; }

    .hero-pupils { position: relative; padding: 0 0 4rem 0; background: var(--color-cream); }

    .hero-pupils-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
      min-height: 400px;
    }

    .hero-pupils-content {
      background: var(--color-navy);
      background-image:
        radial-gradient(circle at 85% 15%, rgba(255, 199, 44, 0.12), transparent 55%),
        linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
      color: var(--color-white);
      padding: 4rem 3.5rem 4rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);
    }

    .hero-pupils-content > * { max-width: 560px; }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background-color: var(--color-gold);
      color: var(--color-navy);
      padding: 0.45rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
      width: fit-content;
    }

    .hero-pupils-heading {
      font-size: clamp(2.25rem, 4.5vw, 3.25rem);
      margin-bottom: 1.1rem;
      line-height: 1.12;
      color: var(--color-white);
      font-weight: 900;
    }

    .hero-pupils-subtext {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.78);
      max-width: 500px;
    }

    .hero-photo-box { position: relative; height: 100%; }

    .hero-photo-placeholder {
      height: 100%;
      min-height: 340px;
      background:
        linear-gradient(180deg, rgba(14,33,84,0.04) 0%, rgba(14,33,84,0.28) 100%),
        linear-gradient(180deg, #FFF1C2 0%, #F4EFE0 100%);
      border-left: 7px solid var(--color-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-family: var(--font-display);
      color: var(--color-navy);
      text-align: center;
      padding: 2rem;
      box-shadow: var(--shadow-lg);
    }

    /* -------------------------------------------------------------------------- */
    /* 5. QUICK CLASS NAVIGATION                                                 */
    /* -------------------------------------------------------------------------- */
    .sticky-class-nav {
      position: sticky;
      top: var(--header-height);
      z-index: 900;
      background: var(--color-cream);
      padding: 1.1rem 0;
      border-bottom: 3px solid var(--color-gold);
      margin-bottom: 3rem;
      box-shadow: var(--shadow-sm);
    }

    .quick-nav-title {
      font-size: 0.85rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-navy);
      margin-bottom: 0.75rem;
    }

    .class-scroll-row {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      scrollbar-width: thin;
    }

    .class-scroll-row::-webkit-scrollbar { height: 4px; }
    .class-scroll-row::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 4px; }

    .class-nav-btn {
      flex: 0 0 auto;
      padding: 0.6rem 1.35rem;
      background: var(--color-white);
      border: 2px solid var(--color-border);
      border-radius: var(--radius-full);
      font-weight: 800;
      font-size: 0.88rem;
      color: var(--color-navy);
      transition: all 0.2s;
    }

    .class-nav-btn:hover {
      border-color: var(--color-gold);
      background-color: var(--color-gold);
      color: var(--color-navy);
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    /* -------------------------------------------------------------------------- */
    /* 6. CLASS SECTIONS — flyer-style colour bar cards                          */
    /* -------------------------------------------------------------------------- */
    .class-section {
      scroll-margin-top: calc(var(--header-height) + 100px);
      margin-bottom: 2.5rem;
    }

    .class-card-block {
      background: var(--color-white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      border-top: 6px solid var(--color-orange);
      transition: box-shadow 0.3s ease;
    }
    .class-card-block:hover { box-shadow: var(--shadow-md); }

    .class-section:nth-of-type(4n+1) .class-card-block { border-top-color: var(--color-orange); }
    .class-section:nth-of-type(4n+2) .class-card-block { border-top-color: var(--color-green); }
    .class-section:nth-of-type(4n+3) .class-card-block { border-top-color: var(--color-blue); }
    .class-section:nth-of-type(4n+4) .class-card-block { border-top-color: var(--color-purple); }

    .class-card-header {
      padding: 1.5rem 2rem;
      background: var(--color-surface-soft);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .class-card-header h2 { font-size: 1.5rem; }

    .class-card-header span {
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--color-navy);
      background: var(--color-gold-light);
      padding: 0.4rem 0.9rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-gold);
      white-space: nowrap;
    }

    .class-card-body { padding: 2rem; }

    .class-group-photo-placeholder {
      width: 100%;
      height: 360px;
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-navy);
      font-weight: 700;
      font-size: 1.1rem;
      text-align: center;
      padding: 1rem;
    }

    .class-group-photo {
      width: 100%;
      height: 360px;
      object-fit: cover;
      border-radius: var(--radius-md);
      display: block;
    }

    .achievements-empty {
      grid-column: 1 / -1;
      text-align: center;
      color: rgba(255, 255, 255, 0.7);
      padding: 2rem 1rem;
      font-size: 1rem;
    }

    .class-privacy-note {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 1rem;
      text-align: right;
      font-weight: 600;
    }

    /* -------------------------------------------------------------------------- */
    /* 7. CELEBRATING OUR PUPILS                                                 */
    /* -------------------------------------------------------------------------- */
    .achievements-wrapper {
      background-color: var(--color-navy);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,199,44,0.10), transparent 55%);
      color: var(--color-white);
      padding: 4rem 0;
      border-radius: var(--radius-lg);
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
    }

    .achievements-intro {
      text-align: center;
      max-width: 600px;
      margin: 0 auto 3rem auto;
    }

    .achievements-intro h2 { color: var(--color-white); font-size: 2.25rem; margin-bottom: 0.5rem; }
    .achievements-intro p { color: rgba(255, 255, 255, 0.78); }

    .session-badge {
      display: inline-block;
      margin-top: 1rem;
      background: rgba(255, 199, 44, 0.12);
      border: 1px solid rgba(255, 199, 44, 0.4);
      color: var(--color-gold);
      font-weight: 800;
      font-size: 0.85rem;
      padding: 0.35rem 0.9rem;
      border-radius: var(--radius-full);
    }

    .achievements-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .digital-award-card {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-left: 5px solid var(--color-gold);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      backdrop-filter: blur(4px);
      transition: transform 0.2s, border-color 0.2s, box-shadow 0.3s ease;
      scroll-margin-top: calc(var(--header-height) + 24px);
    }

    .digital-award-card:hover { transform: translateY(-4px); border-color: var(--color-gold); }

    /* Momentary highlight when a card is opened directly from a shared link */
    .digital-award-card.award-highlight {
      border-color: var(--color-gold);
      box-shadow: 0 0 0 3px rgba(255, 199, 44, 0.45), var(--shadow-lg);
    }

    /* Colour-code by award type — cycles every 6 cards (Overall, 1st, 2nd, 3rd, Maths, English) */
    .digital-award-card:nth-child(6n+1) { border-left-color: var(--color-gold); }
    .digital-award-card:nth-child(6n+2) { border-left-color: var(--color-orange); }
    .digital-award-card:nth-child(6n+3) { border-left-color: var(--color-blue); }
    .digital-award-card:nth-child(6n+4) { border-left-color: var(--color-purple); }
    .digital-award-card:nth-child(6n+5) { border-left-color: var(--color-green); }
    .digital-award-card:nth-child(6n+6) { border-left-color: var(--color-red); }

    .award-type-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--color-gold);
      color: var(--color-navy);
      font-size: 0.8rem;
      font-weight: 800;
      padding: 0.3rem 0.8rem;
      border-radius: var(--radius-full);
      width: fit-content;
      margin-bottom: 1.25rem;
    }

    .awardee-name { font-size: 1.4rem; color: var(--color-white); margin-bottom: 0.25rem; }
    .awardee-meta { font-size: 0.9rem; color: rgba(255, 255, 255, 0.65); }

    .class-select-container { margin-top: 1.25rem; }

    .class-select {
      padding: 0.6rem 1.25rem;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      background-color: var(--color-navy-soft);
      color: var(--color-white);
      border: 1.5px solid rgba(255, 199, 44, 0.4);
      outline: none;
      cursor: pointer;
      transition: border-color 0.2s;
    }

    .class-select:focus, .class-select:hover { border-color: var(--color-gold); }

    /* -------------------------------------------------------------------------- */
    /* 8. PARENT CTA                                                             */
    /* -------------------------------------------------------------------------- */
    .parent-cta-box {
      background: var(--color-orange);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,255,255,0.14), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2rem;
      text-align: center;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
    }

    .parent-cta-box h2 { color: var(--color-white); font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
    .parent-cta-box p { font-size: 1.1rem; color: rgba(255, 255, 255, 0.92); margin-bottom: 1.75rem; max-width: 560px; margin-left: auto; margin-right: auto; }

    /* -------------------------------------------------------------------------- */
    /* 9. FOOTER — moved to src/components/Footer.astro                          */
    /* -------------------------------------------------------------------------- */
    .footer {
      background-color: var(--color-navy-deep);
      color: var(--color-white);
      padding: 5rem 0 2.5rem 0;
      border-top: 4px solid var(--color-gold);
    }

    .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 3rem; margin-bottom: 4rem; }

    .footer-brand p { color: rgba(255, 255, 255, 0.7); margin-top: 1.25rem; font-size: 0.95rem; max-width: 320px; line-height: 1.6; }

    .footer-column h4 { color: var(--color-gold); font-size: 1.02rem; margin-bottom: 1.5rem; font-weight: 800; }
    .footer-column ul { list-style: none; }
    .footer-column li { margin-bottom: 0.85rem; }
    .footer-column a, .address { color: rgba(255, 255, 255, 0.75); font-size: 0.95rem; transition: color 0.2s; }
    .footer-column a:hover { color: var(--color-gold); }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.6);
    }

    .footer-bottom-links { display: flex; align-items: center; gap: 1.5rem; }
    .footer-bottom a { color: rgba(255, 255, 255, 0.75); transition: color 0.2s; }
    .footer-bottom a:hover { color: var(--color-gold); }

    /* -------------------------------------------------------------------------- */
    /* 10. RESPONSIVE BREAKPOINTS                                                */
    /* -------------------------------------------------------------------------- */
    @media (max-width: 992px) {
      .hero-pupils-grid { grid-template-columns: 1fr; min-height: unset; }
      .hero-pupils-content { clip-path: none; padding: 3.25rem 1.5rem; }
      .hero-pupils-content > * { max-width: 100%; }
      .hero-photo-box { height: 300px; }
      .hero-photo-placeholder { min-height: 300px; border-left: none; border-top: 6px solid var(--color-gold); }
    }

    @media (max-width: 900px) {
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 850px) {
      .nav-links, .header-cta { display: none; }
      .mobile-menu-btn { display: flex; }

      .nav-links.active {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: var(--header-height);
        left: 0;
        right: 0;
        background-color: var(--color-navy);
        padding: 1.75rem;
        border-bottom: 3px solid var(--color-gold);
        box-shadow: var(--shadow-md);
        gap: 1.25rem;
        z-index: 999;
      }

      .mobile-menu-btn.active span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
      .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
      .mobile-menu-btn.active span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

      .container { padding: 0 1rem; }

      .footer-bottom { flex-direction: column; text-align: center; gap: 1rem; }
      .footer-bottom-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    }

    @media (max-width: 680px) {
