<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Launchpad | Dan-Gracious Land</title>

<!-- Keep this site out of search results — it's an internal handoff page, not public content -->
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800;900&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="apple-touch-icon" sizes="180x180" href="asset/favicon_io/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="asset/favicon_io/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="asset/favicon_io/favicon-16x16.png">
<link rel="manifest" href="asset/favicon_io/site.webmanifest">

<style>
/* ════════════════════════════════════════════════
   THEME TOKENS — retoned to match the DGL site
   (index.html / about.html) design system.
════════════════════════════════════════════════ */
:root {
  /* Color */
  --bg:        #FFF9EC;   /* page background — DGL cream */
  --surface:   #FFFFFF;   /* card background */
  --surface-2: #F4EFE0;   /* hover / secondary surface */
  --border:    #E7DFC8;
  --text:      #101B3D;
  --text-dim:  #5B6280;
  --accent:    #FFC72C;   /* DGL gold */
  --accent-text: #0E2154; /* DGL navy */
  --navy:      #0E2154;
  --navy-deep: #081533;

  /* Type */
  --font-display: 'Poppins', -apple-system, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* Shape */
  --radius: 12px;
  --radius-lg: 20px;

  /* Shadow */
  --shadow-sm: 0 4px 10px -2px rgba(14, 33, 84, 0.10);
  --shadow-md: 0 14px 28px -8px rgba(14, 33, 84, 0.16);
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32px 20px;
}

.sheet {
  width: 100%;
  max-width: 460px;
}

/* ── Logo slot ───────────────────────────── */
.logo-slot {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 20px;
}

.logo-slot img {
  height: 44px;
  width: auto;
  display: block;
}

.logo-slot .brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.3;
}

.logo-slot .brand-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 1rem;
  letter-spacing: 0.01em;
  color: var(--navy);
}

.logo-slot .brand-subtitle {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--text-dim);
}

/* ── Level-color ribbon strip — DGL brand motif ─ */
.level-stripe {
  display: flex;
  height: 5px;
  width: 100%;
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 32px;
}
.level-stripe span { flex: 1; }
.level-stripe .s-orange { background: #F0640F; }
.level-stripe .s-green  { background: #2E9E4F; }
.level-stripe .s-blue   { background: #1F5FD1; }
.level-stripe .s-purple { background: #6B3FA0; }

/* ── Section card ────────────────────────── */
.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 28px 24px;
  margin-bottom: 20px;
  box-shadow: var(--shadow-sm);
}

.card-eyebrow {
  font-family: var(--font-display);
  font-size: 0.72rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--text-dim);
  margin: 0 0 14px;
}

/* ── Buttons ─────────────────────────────── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 15px 20px;
  border-radius: 999px;
  font-family: var(--font-display);
  font-size: 0.98rem;
  font-weight: 700;
  text-decoration: none;
  border: 1px solid var(--border);
  transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.btn:active { transform: scale(0.985); }

.btn-primary {
  background: var(--accent);
  color: var(--accent-text);
  border-color: var(--accent);
  box-shadow: 0 10px 20px -6px rgba(255, 199, 44, 0.5);
}
.btn-primary:hover { background: #F2A900; transform: translateY(-2px); }

.btn-secondary {
  background: var(--navy);
  color: #FFFFFF;
  border-color: var(--navy);
  box-shadow: 0 10px 20px -6px rgba(14, 33, 84, 0.35);
}
.btn-secondary:hover { background: #1C3576; transform: translateY(-2px); }

/* ── URL row ─────────────────────────────── */
.url-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
  font-size: 0.85rem;
  color: var(--text-dim);
}

.url-row code {
  flex: 1;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 0.82rem;
  word-break: break-all;
  background: var(--surface-2);
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid var(--border);
  color: var(--text);
}

.copy-btn {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface-2);
  color: var(--text-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
}
.copy-btn:hover { border-color: var(--accent); color: var(--navy); background: #FFF1C2; }
.copy-btn svg { width: 15px; height: 15px; }

/* ── QR block ────────────────────────────── */
.qr-wrap {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 16px;
}

.qr-wrap img {
  width: 96px;
  height: 96px;
  border-radius: 10px;
  background: #fff;
  padding: 6px;
  border: 1px solid var(--border);
  display: block;
}

.qr-caption {
  font-size: 0.82rem;
  color: var(--text-dim);
  line-height: 1.5;
}

.qr-caption a {
  color: var(--navy);
  font-weight: 700;
  text-decoration: none;
}
.qr-caption a:hover { color: #F0640F; text-decoration: underline; }

/* ── Footer ──────────────────────────────── */
.footer {
  text-align: center;
  font-size: 0.78rem;
  color: var(--text-dim);
  margin-top: 28px;
}

.footer a {
  color: inherit;
  text-decoration: none;
}
.footer a:hover { color: var(--navy); text-decoration: underline; }

@media (max-width: 380px) {
  .card { padding: 22px 18px; }
}
</style>
</head>
<body>

<div class="sheet">

  <!-- LOGO SLOT — swap the <img> src, or delete it and keep just the text -->
  <div class="logo-slot">
    <img src="asset/DGLS-Badge-two-colour.svg" alt="DAN-GRACIOUS LAND Badge" onerror="this.style.display='none'">
    <div class="brand-text">
      <span class="brand-title">DAN-GRACIOUS LAND</span>
      <span class="brand-subtitle">Nursery & Primary School</span>
    </div>
  </div>

  <div class="level-stripe" aria-hidden="true">
    <span class="s-orange"></span><span class="s-green"></span><span class="s-blue"></span><span class="s-purple"></span>
  </div>

  <!-- PRODUCTION -->
  <div class="card">
    <p class="card-eyebrow">Production</p>
    <a class="btn btn-primary" href="https://dangraciousland.pages.dev" target="_blank" rel="noopener">
      View Live Site
    </a>

    <div class="url-row">
      <code id="prod-url">https://dangraciousland.pages.dev</code>
      <button class="copy-btn" onclick="copyUrl('prod-url', this)" aria-label="Copy production URL">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
      </button>
    </div>

    <div class="qr-wrap">
      <!-- QR auto-generated from the production URL above — no JS dependency, just a query param -->
      <img src="asset/qrcode.png" id="qr-img" alt="QR code linking to the live site">
      <p class="qr-caption">Scan to open on mobile, or <a href="asset/qrcode.png" id="qr-download" download>download the QR</a>.</p>
    </div>
  </div>

  <!-- MANAGEMENT -->
  <div class="card">
    <p class="card-eyebrow">Management</p>
    <a class="btn btn-secondary" href="https://dangraciousland.pages.dev/keystatic" target="_blank" rel="noopener">
      Edit Live Site
    </a>
  </div>

  <p class="footer">Internal handoff page — <a href="https://example.com">not indexed, not public</a></p>

</div>

<script is:inline>
  function copyUrl(id, btn) {
    const text = document.getElementById(id).textContent.trim();
    navigator.clipboard.writeText(text).then(() => {
      const original = btn.innerHTML;
      btn.innerHTML = '✓';
      setTimeout(() => { btn.innerHTML = original; }, 1200);
    });
  }
</script>

</body>
</html>
