---
export const prerender = true;

import { createReader } from '@keystatic/core/reader';
import keystaticConfig, { LIFE_CATEGORY_OPTIONS, MAX_LIFE_POSTS } from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const siteSettings = await reader.singletons.siteSettings.read();
const lifePageData = await reader.singletons.lifePage.read();

// siteSettings is null until someone opens /keystatic and saves the
// "Site Settings & Footer" singleton at least once — the config's
// defaultValue is only a form default in the admin UI, it doesn't create
// a content file by itself. Fall back so a fresh/empty CMS never breaks
// the build; once it's saved for real, these fallbacks are simply unused.
const phoneSupport = siteSettings?.phoneSupport ?? '+2348000000000';
const whatsAppChannelLink = siteSettings?.whatsAppChannelLink ?? 'https://wa.me/';


// Pull the fixed post1..postN slots into a flat array (each tagged with
// its own stable slug so share links/IDs never shift even if display
// order changes later), keep only slots an editor actually filled in
// (per "if there's no post on a template, hide it"), then sort by
// publish date, most recent first.
const CATEGORY_LABELS = Object.fromEntries(LIFE_CATEGORY_OPTIONS.map((c) => [c.value, c.label]));
const TONE_CYCLE = ['', 'tone-green', 'tone-blue', 'tone-purple'];

function formatMonthYear(dateStr) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  if (Number.isNaN(d.getTime())) return '';
  return d.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

// Editors were told to paste an "embed URL", but in practice people paste
// whatever's in their browser bar or share sheet — a normal youtube.com
// /watch?v= link, a youtu.be/ short link, a /shorts/ link, or a plain
// vimeo.com/ID link. None of those actually render inside an <iframe>
// (YouTube/Vimeo block framing the regular watch page), which is exactly
// why the video was coming up blank/404-like. This converts whatever was
// pasted into the one URL shape that's actually embeddable, and leaves
// anything already in embed form (or from an unrecognized host) untouched.
function toEmbedVideoUrl(rawUrl) {
  if (!rawUrl) return null;
  // YouTube/Vimeo's "Share > Embed" button hands people a *whole*
  // <iframe src="..." ...></iframe> snippet, not a bare link — and given
  // this field is literally labeled "Video Embed URL", pasting that whole
  // snippet in is a completely natural thing to do. Pull the src="..."
  // out of it first so that case works too, instead of only accepting a
  // plain URL and silently falling back to the thumbnail on anything else.
  let candidate = rawUrl.trim();
  const iframeSrcMatch = candidate.match(/<iframe\b[^>]*\bsrc\s*=\s*["']([^"']+)["']/i);
  if (iframeSrcMatch) {
    candidate = iframeSrcMatch[1];
  }
  let u;
  try {
    u = new URL(candidate);
  } catch {
    // Most common real-world mistake: the scheme got dropped when pasting
    // (e.g. "youtu.be/xyz123" instead of "https://youtu.be/xyz123"). Retry
    // once with a scheme before giving up — without this, the bare string
    // used to get returned as-is and fed straight into an <iframe src="">,
    // where a browser resolves a scheme-less value as a *relative path on
    // our own site* rather than an external address. That's exactly why a
    // mistyped paste ended up silently loading our own 404 page inside the
    // video frame instead of the actual video.
    try {
      u = new URL(`https://${candidate}`);
    } catch {
      return null;
    }
  }
  const host = u.hostname.replace(/^www\./, '').replace(/^m\./, '');

  if (host === 'youtu.be') {
    const id = u.pathname.slice(1).split('/')[0];
    return id ? `https://www.youtube.com/embed/${id}` : null;
  }
  if (host === 'youtube.com') {
    if (u.pathname === '/watch') {
      const id = u.searchParams.get('v');
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    if (u.pathname.startsWith('/shorts/')) {
      const id = u.pathname.split('/')[2];
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
    if (u.pathname.startsWith('/embed/')) {
      return u.toString();
    }
  }
  if (host === 'vimeo.com') {
    const id = u.pathname.split('/').filter(Boolean)[0];
    return id ? `https://player.vimeo.com/video/${id}` : null;
  }
  // player.vimeo.com links, or anything else — pass through, but only as
  // the genuine absolute http(s) URL that the successful `new URL()` parse
  // above guarantees we have, never a bare/relative string that could
  // resolve against our own domain.
  return u.protocol === 'http:' || u.protocol === 'https:' ? u.toString() : null;
}

const allSlots = Array.from({ length: MAX_LIFE_POSTS }, (_, i) => {
  const raw = lifePageData?.[`post${i + 1}`];
  return raw ? { ...raw, slug: `post-${i + 1}` } : null;
}).filter(Boolean);

const posts = allSlots
  .filter((p) => p.title && p.title.trim() !== '')
  .sort((a, b) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime())
  .map((p) => {
    const isVideo = p.media?.discriminant === 'video';
    // Image posts: media.value is the image path string directly.
    // Video posts: media.value is now { url, thumbnail } — thumbnail is
    // optional, so a video post without one still falls back to the
    // decorative icon rather than showing a broken image.
    const imageUrl = isVideo ? (p.media?.value?.thumbnail || null) : (p.media?.value || null);
    const videoUrl = isVideo ? toEmbedVideoUrl(p.media?.value?.url || null) : null;
    return {
      slug: p.slug,
      title: p.title,
      category: p.category,
      categoryLabel: CATEGORY_LABELS[p.category] ?? p.category,
      dateLabel: formatMonthYear(p.publishedDate),
      description: p.description || '',
      isVideo,
      imageUrl,
      videoUrl,
    };
  });

const featured = posts[0] ?? null;
const gridPosts = posts.slice(1);

// Data handed to the client-side script as inert JSON (not executed code),
// so the behavioral script below can stay a plain classic `is:inline`
// script — required so its onclick-referenced functions remain globally
// callable — while still getting real, CMS-sourced content to open in the
// modal for any post, including ones reached via a shared link.
const clientPosts = Object.fromEntries(
  posts.map((p) => [
    p.slug,
    {
      title: p.title,
      meta: `${p.categoryLabel} · ${p.dateLabel}`,
      text: p.description,
      imageUrl: p.imageUrl,
      videoUrl: p.videoUrl,
    },
  ])
);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Life at DGL | Dan-Gracious Land Nursery & Primary School</title>
  <meta name="description" content="Explore activities, cultural events, sports, and classroom moments at Dan-Gracious Land Nursery & Primary School in Idimu, Lagos." />

  <meta property="og:title" content="Life at Dan-Gracious Land Nursery & Primary School" />
  <meta property="og:description" content="A visual journal of moments, learning, and growth at DGL." />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">

  <style>
    /* -------------------------------------------------------------------------- */
    /* 1. DESIGN SYSTEM — TOKENS SHARED WITH THE HOMEPAGE                        */
    /* -------------------------------------------------------------------------- */
    :root {
      --color-navy: #0E2154;
      --color-navy-deep: #081533;
      --color-navy-soft: #1C3576;
      --color-cream: #FFF9EC;
      --color-cream-card: #FFFFFF;
      --color-gold: #FFC72C;
      --color-gold-deep: #F2A900;
      --color-gold-light: #FFF1C2;
      --color-orange: #F0640F;
      --color-orange-hover: #D4530A;
      --color-green: #2E9E4F;
      --color-blue: #1F5FD1;
      --color-purple: #6B3FA0;
      --color-red: #C81E2C;
      --color-text-dark: #101B3D;
      --color-text-muted: #5B6280;
      --color-white: #FFFFFF;
      --color-surface-soft: #F4EFE0;
      --color-border: #E7DFC8;

      --font-display: 'Poppins', -apple-system, sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Inter', -apple-system, sans-serif;

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --radius-full: 9999px;

      --shadow-sm: 0 4px 10px -2px rgba(14, 33, 84, 0.10);
      --shadow-md: 0 14px 28px -8px rgba(14, 33, 84, 0.18);
      --shadow-lg: 0 30px 60px -16px rgba(14, 33, 84, 0.30);

      --glass-bg: rgba(14, 33, 84, 0.97);
      --glass-border: rgba(255, 199, 44, 0.25);

      --container-max: 1240px;
      --header-height: 84px;
    }

    /* -------------------------------------------------------------------------- */
    /* 2. RESET & BASE                                                           */
    /* -------------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: var(--font-body);
      background-color: var(--color-cream);
      color: var(--color-text-dark);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; font-size: inherit; cursor: pointer; border: none; background: none; }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* -------------------------------------------------------------------------- */
    /* 3. TYPOGRAPHY & BUTTONS                                                    */
    /* -------------------------------------------------------------------------- */
    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1.15;
      color: var(--color-navy);
      letter-spacing: -0.01em;
    }

    .section-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.15rem;
      background: var(--color-orange);
      color: var(--color-white);
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-radius: var(--radius-full);
      margin-bottom: 1rem;
      box-shadow: var(--shadow-sm);
    }
    .section-tag.tag-blue { background: var(--color-blue); }
    .section-tag.tag-purple { background: var(--color-purple); }
    .section-tag.tag-green { background: var(--color-green); }

    .section-title-wrap { max-width: 620px; margin: 0 auto 3rem auto; text-align: center; }
    .section-title-wrap h2 { font-size: clamp(2rem, 4vw, 2.5rem); margin-bottom: 0.5rem; font-weight: 900; }
    .section-title-wrap p { font-size: 1.05rem; color: var(--color-text-muted); }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.9rem 2.1rem;
      font-weight: 800;
      font-size: 1rem;
      border-radius: var(--radius-full);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      text-align: center;
      min-height: 52px;
    }

    .btn-primary {
      background-color: var(--color-orange);
      color: var(--color-white);
      box-shadow: 0 10px 22px -6px rgba(240, 100, 15, 0.5);
    }
    .btn-primary:hover {
      background-color: var(--color-orange-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 26px -6px rgba(240, 100, 15, 0.55);
    }

    .btn-secondary {
      background-color: var(--color-navy);
      color: var(--color-white);
      box-shadow: 0 10px 20px -5px rgba(10, 15, 29, 0.3);
    }
    .btn-secondary:hover {
      background-color: var(--color-navy-soft);
      transform: translateY(-3px);
      box-shadow: 0 14px 24px -4px rgba(10, 15, 29, 0.4);
    }

    .btn-secondary2 {
      background-color: var(--color-white);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(0,0,0,0.15);
    }
    .btn-secondary2:hover { transform: translateY(-3px); }

    .btn-outline {
      border: 2.5px solid var(--color-gold);
      color: var(--color-navy);
      background: var(--color-white);
    }
    .btn-outline:hover {
      background-color: var(--color-gold);
      color: var(--color-navy);
      transform: translateY(-3px);
    }

    .btn-gold {
      background-color: var(--color-gold);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(255, 199, 44, 0.55);
    }
    .btn-gold:hover {
      background-color: var(--color-gold-deep);
      transform: translateY(-3px);
    }

    .btn-share {
      background-color: var(--color-cream-card);
      color: var(--color-navy);
      border: 1.5px solid var(--color-border);
      padding: 0.5rem 1rem;
      font-size: 0.82rem;
      border-radius: var(--radius-full);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
    }
    .btn-share:hover {
      background-color: var(--color-gold);
      border-color: var(--color-gold);
      transform: translateY(-2px);
    }

    /* Level-color ribbon strip — echoes the flyer's Creche/Nursery/Primary/Secondary bars */
    .level-stripe { display: flex; height: 7px; width: 100%; }
    .level-stripe span { flex: 1; }
    .level-stripe .s-orange { background: var(--color-orange); }
    .level-stripe .s-green { background: var(--color-green); }
    .level-stripe .s-blue { background: var(--color-blue); }
    .level-stripe .s-purple { background: var(--color-purple); }

    /* -------------------------------------------------------------------------- */
    /* 4. HEADER & NAVIGATION                                                     */
    /* -------------------------------------------------------------------------- */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background-color: var(--color-navy);
      height: var(--header-height);
      display: flex;
      align-items: center;
      box-shadow: 0 6px 18px -8px rgba(8, 21, 51, 0.45);
    }

    .header .container { display: flex; align-items: center; justify-content: space-between; }

    .brand { display: flex; align-items: center; gap: 0.85rem; }

    .brand-badge { width: auto; height: 60px; display: flex; align-items: center; justify-content: center; }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.05rem;
      line-height: 1;
      color: var(--color-white);
      letter-spacing: 0.01em;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--color-gold-light);
      font-weight: 600;
      display: block;
      margin-top: 3px;
    }

    .nav-links { display: flex; align-items: center; gap: 2.25rem; list-style: none; }
    .nav-links a { font-weight: 700; font-size: 0.92rem; color: var(--color-white); transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--color-gold); }

    .mobile-menu-btn { display: none; flex-direction: column; gap: 6px; padding: 0.5rem; }
    .mobile-menu-btn span { width: 26px; height: 2.5px; background-color: var(--color-gold); border-radius: 4px; transition: all 0.3s ease; }

    /* -------------------------------------------------------------------------- */
    /* 5. BREADCRUMBS                                                            */
    /* -------------------------------------------------------------------------- */
    .breadcrumbs-bar { padding: 1.25rem 0 0.5rem 0; background: var(--color-cream); }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-muted);
      list-style: none;
    }

    .breadcrumbs a { color: var(--color-navy); }
    .breadcrumbs a:hover { color: var(--color-orange); }
    .breadcrumbs li[aria-current] { color: var(--color-orange); font-weight: 800; }

    /* -------------------------------------------------------------------------- */
    /* 6. HERO — angled navy panel + photo-placeholder frame (matches About page) */
    /* -------------------------------------------------------------------------- */
    .hero-life { position: relative; padding: 0 0 4rem 0; background: var(--color-cream); }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      align-items: stretch;
      min-height: 400px;
    }

    .hero-content {
      background: var(--color-navy);
      background-image:
        radial-gradient(circle at 85% 15%, rgba(255, 199, 44, 0.12), transparent 55%),
        linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
      color: var(--color-white);
      padding: 4rem 3.5rem 4rem 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      clip-path: polygon(0 0, 100% 0, 88% 100%, 0% 100%);
      position: relative;
    }

    .hero-content > * { max-width: 560px; }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background-color: var(--color-gold);
      color: var(--color-navy);
      padding: 0.45rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
      width: fit-content;
    }

    .hero-heading {
      font-size: clamp(2.25rem, 4.5vw, 3.25rem);
      margin-bottom: 1.25rem;
      line-height: 1.12;
      color: var(--color-white);
      font-weight: 900;
    }

    .hero-heading span { color: var(--color-gold); }

    .hero-subtext {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.78);
      max-width: 500px;
    }

    .hero-media { position: relative; height: 100%; }

    .hero-photo-placeholder {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 320px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      border-left: 7px solid var(--color-gold);
      box-shadow: var(--shadow-lg);
    }

    .hero-photo-placeholder .placeholder-icon { font-size: 3rem; margin-bottom: 0.75rem; }

    .hero-photo-placeholder .placeholder-label {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      background: var(--color-navy);
      color: var(--color-white);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.85rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      padding: 0.9rem 1rem;
    }

    /* -------------------------------------------------------------------------- */
    /* 7. FEATURED MOMENT — navy card, gold badge (matches location/heart panels) */
    /* -------------------------------------------------------------------------- */
    .featured-section { margin-bottom: 3rem; }

    .featured-card {
      background: var(--color-navy);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,199,44,0.12), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      box-shadow: var(--shadow-lg);
      border-top: 6px solid var(--color-gold);
    }

    .featured-media {
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      min-height: 320px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    .featured-media img { width: 100%; height: 100%; object-fit: cover; }

    .featured-media .placeholder-icon { font-size: 3.25rem; }

    .featured-content {
      padding: 3rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .featured-badge {
      display: inline-block;
      background: var(--color-gold);
      color: var(--color-navy);
      font-weight: 800;
      font-size: 0.8rem;
      padding: 0.4rem 1rem;
      border-radius: var(--radius-full);
      margin-bottom: 1.1rem;
      width: fit-content;
      box-shadow: var(--shadow-sm);
    }

    .featured-content h2 {
      color: var(--color-white);
      font-size: 1.9rem;
      margin-bottom: 0.85rem;
    }

    .featured-meta {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 1.75rem;
    }

    /* -------------------------------------------------------------------------- */
    /* 8. CATEGORY FILTER NAVIGATION                                              */
    /* -------------------------------------------------------------------------- */
    .category-filter-nav {
      position: sticky;
      top: calc(var(--header-height) + 7px);
      z-index: 900;
      background: rgba(255, 249, 236, 0.95);
      backdrop-filter: blur(8px);
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: 3rem;
    }

    .filter-scroll-row {
      display: flex;
      gap: 0.6rem;
      overflow-x: auto;
      padding-bottom: 0.25rem;
      scrollbar-width: thin;
    }

    .filter-scroll-row::-webkit-scrollbar { height: 4px; }
    .filter-scroll-row::-webkit-scrollbar-thumb { background: var(--color-border); border-radius: 4px; }

    .filter-btn {
      flex: 0 0 auto;
      padding: 0.55rem 1.25rem;
      background: var(--color-white);
      border: 1.5px solid var(--color-border);
      border-radius: var(--radius-full);
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--color-navy);
      transition: all 0.2s;
    }

    .filter-btn:hover, .filter-btn.active {
      background-color: var(--color-navy);
      border-color: var(--color-navy);
      color: var(--color-white);
      box-shadow: var(--shadow-sm);
    }

    /* -------------------------------------------------------------------------- */
    /* 9. VISUAL JOURNAL GRID — responsive grid, colour-cycling top borders      */
    /* -------------------------------------------------------------------------- */
    .journal-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.75rem;
      margin-bottom: 4rem;
    }

    .journal-card {
      background: var(--color-cream-card);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
      cursor: pointer;
      border-top: 6px solid var(--color-orange);
    }

    .journal-card.tone-green { border-top-color: var(--color-green); }
    .journal-card.tone-blue { border-top-color: var(--color-blue); }
    .journal-card.tone-purple { border-top-color: var(--color-purple); }

    .journal-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }

    .card-media {
      position: relative;
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      height: 220px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-media img { width: 100%; height: 100%; object-fit: cover; }

    .card-media .placeholder-icon { font-size: 2.5rem; }

    .video-indicator {
      position: absolute;
      width: 52px;
      height: 52px;
      background: var(--color-navy);
      border: 3px solid var(--color-white);
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-gold);
      font-size: 1.2rem;
      box-shadow: var(--shadow-md);
    }

    .card-body {
      padding: 1.5rem 1.6rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .card-meta-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.6rem;
    }

    .card-category {
      font-size: 0.75rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-orange);
    }

    .journal-card.tone-green .card-category { color: var(--color-green); }
    .journal-card.tone-blue .card-category { color: var(--color-blue); }
    .journal-card.tone-purple .card-category { color: var(--color-purple); }

    .card-date { font-size: 0.75rem; color: var(--color-text-muted); }

    .card-title { font-size: 1.2rem; margin-bottom: 0.4rem; }

    .card-footer {
      margin-top: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.9rem;
      border-top: 1px solid var(--color-surface-soft);
    }

    .card-action-text {
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--color-orange);
    }

    .journal-card.tone-green .card-action-text { color: var(--color-green); }
    .journal-card.tone-blue .card-action-text { color: var(--color-blue); }
    .journal-card.tone-purple .card-action-text { color: var(--color-purple); }

    /* -------------------------------------------------------------------------- */
    /* 9b. EMPTY STATE — shown when zero posts are published                     */
    /* -------------------------------------------------------------------------- */
    .empty-life-state {
      background: var(--color-cream-card);
      border: 1.5px dashed var(--color-border);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2rem;
      text-align: center;
      margin-bottom: 4rem;
    }
    .empty-life-state p {
      font-size: 1.1rem;
      color: var(--color-text-muted);
      font-weight: 600;
    }

    /* -------------------------------------------------------------------------- */
    /* 10. MODAL / POST DETAIL VIEW                                               */
    /* -------------------------------------------------------------------------- */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.9);
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      opacity: 0;
      visibility: hidden;
      transition: all 0.25s ease;
    }

    .modal-overlay.open { opacity: 1; visibility: visible; }

    .modal-container {
      /* No card — just centers whatever media + caption it holds. Sizing
         now lives on the media itself (see .modal-media-box below): a
         photo scales via plain max-width/max-height + object-fit: contain
         on the <img> (no JS pixel math needed), and a video's box is
         sized in JS from its thumbnail's aspect ratio, since an <iframe>
         has no intrinsic size to scale from the way an image does. The
         container itself no longer pre-computes its own width — that's
         what let it drift out of sync with the media's actual rendered
         size. */
      background: transparent;
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 96vw;
      width: auto;
      min-width: 280px;
      max-height: 96vh;
      overflow: visible;
      position: relative;
      box-shadow: none;
    }

    .modal-close-btn {
      /* Fixed to the screen corner, independent of the media's own size
         or shape — the same way native gallery/photo viewers place a
         close/back button. 16px (1rem) padding from the edge, always on
         top of the media, nav arrows and rotate control. */
      position: fixed;
      top: 1rem;
      right: 1rem;
      width: 38px;
      height: 38px;
      background: var(--color-navy);
      color: var(--color-white);
      border: none;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      z-index: 2030;
      box-shadow: var(--shadow-lg);
      transition: background-color 0.2s;
      cursor: pointer;
    }
    .modal-close-btn:hover { background: var(--color-orange); }

    /* Prev/next — desktop only. On mobile, navigation happens by
       swiping the media itself instead, so these are hidden below 701px. */
    .modal-nav-btn {
      position: fixed;
      top: 50%;
      transform: translateY(-50%);
      width: 44px;
      height: 44px;
      background: rgba(8, 21, 51, 0.6);
      color: var(--color-white);
      border: none;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      cursor: pointer;
      z-index: 2020;
      transition: background-color 0.2s;
    }
    .modal-nav-btn:hover { background: var(--color-orange); }
    .modal-nav-btn.modal-prev-btn { left: 1rem; }
    .modal-nav-btn.modal-next-btn { right: 1rem; }
    .modal-nav-btn[hidden] { display: none; }
    @media (max-width: 700px) {
      .modal-nav-btn { display: none !important; }
    }

    /* Rotate — bottom center. Photos only: rotating an embedded video
       player doesn't apply, so this stays hidden whenever a video is open. */
    .modal-rotate-btn {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      width: 40px;
      height: 40px;
      background: rgba(8, 21, 51, 0.7);
      color: var(--color-white);
      border: none;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      cursor: pointer;
      z-index: 2020;
      transition: background-color 0.2s;
    }
    .modal-rotate-btn:hover { background: var(--color-orange); }
    .modal-rotate-btn[hidden] { display: none; }

    .modal-media-box {
      width: auto;
      max-width: 90vw;
      background: var(--color-navy-deep);
      border-radius: var(--radius-lg);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-white);
      position: relative;
      text-align: center;
      padding: 0;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      touch-action: pan-y;
    }

    /* Default / no-media-yet state — keeps the old fixed box so the
       "[ Photo View: ... ]" placeholder still has something to sit in. */
    .modal-media-box { height: 340px; }

    /* Images: never crop. width/height: auto plus matching max-width and
       max-height on the <img> itself (object-fit: contain as a backstop)
       means the browser scales the photo up to whichever limit it hits
       first — no JS pixel math needed, so there's nothing for the box
       and the actual photo to drift out of sync on. A wide landscape
       photo fills the width with letterboxing above/below; a tall
       portrait photo fills the height with letterboxing at the sides —
       same as a phone's native gallery. Capped at 90% of the viewport
       per spec, with headroom left below for the caption and rotate
       control. */
    .modal-media-box.is-image {
      height: auto;
      max-height: 82vh;
    }
    .modal-media-box.is-image img {
      display: block;
      width: auto;
      height: auto;
      max-width: 90vw;
      max-height: 82vh;
      object-fit: contain;
    }

    /* Video: an <iframe> has no intrinsic size to scale from the way an
       <img> does, so it can't just be handed max-width/max-height and
       left to size itself — the box's actual pixel size still comes from
       JS (sizeModalToMedia, using the post's thumbnail as a stand-in for
       the video's real aspect ratio, or a 16:9 assumption when there's no
       thumbnail at all). This rule is only the very first paint's
       fallback, capped the same as images. */
    .modal-media-box.is-video {
      height: auto;
      aspect-ratio: 16 / 9;
      max-width: 90vw;
      max-height: 82vh;
    }
    .modal-media-box.is-video iframe {
      width: 100%;
      height: 100%;
      display: block;
      border: 0;
    }

    @media (max-width: 700px) {
      /* Mobile gets near-full-screen per spec — a small edge margin and
         just enough headroom left for the caption below. */
      .modal-overlay { padding: 0.5rem; }
      .modal-media-box.is-image,
      .modal-media-box.is-video {
        max-width: 96vw;
      }
      .modal-media-box.is-image img {
        max-width: 96vw;
      }
      .modal-media-box.is-image,
      .modal-media-box.is-image img,
      .modal-media-box.is-video {
        max-height: 74vh;
      }
    }

    /* Plain text caption under the photo — no background, no padding box,
       just a title and category/date sitting directly on the dark backdrop
       (matches what was asked for: a small caption is fine, a separate
       boxed card is not). Scrolls internally instead of ever overlapping
       the media above it. */
    .modal-caption {
      margin-top: 0.85rem;
      text-align: center;
      max-width: 96vw;
      max-height: 12vh;
      overflow-y: auto;
    }
    .modal-caption-title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--color-white);
      text-shadow: 0 1px 6px rgba(0,0,0,0.55);
      margin-bottom: 0.2rem;
    }
    .modal-caption-meta {
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(255,255,255,0.75);
      text-shadow: 0 1px 6px rgba(0,0,0,0.55);
    }

    /* -------------------------------------------------------------------------- */
    /* 11. ADMISSIONS CTA — orange gradient banner (matches Leadership CTA)      */
    /* -------------------------------------------------------------------------- */
    .parent-cta-box {
      background: var(--color-orange);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,255,255,0.14), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2rem;
      text-align: center;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
    }

    .parent-cta-box h2 {
      color: var(--color-white);
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      margin-bottom: 0.5rem;
    }

    .parent-cta-box p {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.92);
      margin-bottom: 1.75rem;
      max-width: 560px;
      margin-left: auto;
      margin-right: auto;
    }

    /* -------------------------------------------------------------------------- */
    /* 12. FOOTER                                                                 */
    /* -------------------------------------------------------------------------- */
    .footer {
      background-color: var(--color-navy-deep);
      color: var(--color-white);
      padding: 5rem 0 2.5rem 0;
      border-top: 4px solid var(--color-gold);
    }

    .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 3rem; margin-bottom: 4rem; }

    .footer-brand p { color: rgba(255, 255, 255, 0.7); margin-top: 1.25rem; font-size: 0.95rem; max-width: 320px; line-height: 1.6; }

    .footer-column h4 { color: var(--color-gold); font-size: 1.02rem; margin-bottom: 1.5rem; font-weight: 800; }
    .footer-column ul { list-style: none; }
    .footer-column li { margin-bottom: 0.85rem; }
    .footer-column a, .address { color: rgba(255, 255, 255, 0.75); font-size: 0.95rem; transition: color 0.2s; }
    .footer-column a:hover { color: var(--color-gold); }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.6);
    }

    .footer-bottom-links { display: flex; align-items: center; gap: 1.5rem; }
    .footer-bottom a { color: rgba(255, 255, 255, 0.75); transition: color 0.2s; }
    .footer-bottom a:hover { color: var(--color-gold); }

    /* -------------------------------------------------------------------------- */
    /* 13. RESPONSIVE                                                            */
    /* -------------------------------------------------------------------------- */
    @media (max-width: 992px) {
      .hero-grid, .featured-card { grid-template-columns: 1fr; }
      .hero-content { clip-path: none; padding: 3.25rem 1.5rem; }
      .hero-content > * { max-width: 100%; }
      .hero-media { height: 300px; }
      .hero-photo-placeholder { min-height: 300px; border-left: none; border-top: 6px solid var(--color-gold); }

      .journal-card.col-span-8,
      .journal-card.col-span-6,
      .journal-card.col-span-4 {
        grid-column: span 12;
      }

      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 850px) {
      .nav-links, .header-cta { display: none; }
      .mobile-menu-btn { display: flex; }
      .footer-grid { grid-template-columns: 1fr; }

      .nav-links.active {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: var(--header-height);
        left: 0;
        right: 0;
        background-color: var(--color-navy);
        padding: 1.75rem;
        border-bottom: 3px solid var(--color-gold);
        box-shadow: var(--shadow-md);
        gap: 1.25rem;
        z-index: 999;
      }

      .mobile-menu-btn.active span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
      .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
      .mobile-menu-btn.active span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

      .container { padding: 0 1rem; }

      .footer-bottom { flex-direction: column; text-align: center; gap: 1rem; }
      .footer-bottom-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    }

    @media (max-width: 680px) {
      .footer-grid { grid-template-columns: 1fr; }
      .featured-content { padding: 1.75rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

  <header class="header">
    <div class="container">
      <a href="/" class="brand">
        <img src="/asset/DGLS-Badge-two-colour.svg" class="brand-badge" alt="DAN-GRACIOUS LAND Badge">
        <div class="brand-text">
          <span class="brand-title">DAN-GRACIOUS LAND</span>
          <span class="brand-subtitle">Nursery & Primary School</span>
        </div>
      </a>

      <nav>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/pupils">Pupils</a></li>
          <li><a href="/life">Life at DGL</a></li>
        </ul>
      </nav>

      <div class="header-cta">
        <a href="/#contact" class="btn btn-gold">Enquire Now</a>
      </div>

      <button class="mobile-menu-btn" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <div class="level-stripe" aria-hidden="true">
    <span class="s-orange"></span><span class="s-green"></span><span class="s-blue"></span><span class="s-purple"></span>
  </div>

  <main>
    <div class="breadcrumbs-bar">
      <div class="container">
        <ul class="breadcrumbs">
          <li><a href="/">Home</a></li>
          <li>&#8250;</li>
          <li aria-current="page">Life at DGL</li>
        </ul>
      </div>
    </div>

    <!-- HERO -->
    <section class="hero-life">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
            <div class="hero-pill">School Experience</div>
            <h1 class="hero-heading">Life at <span>DGL</span></h1>
            <p class="hero-subtext">Learning doesn't stop when the lesson ends. See the moments, activities and experiences that make life at DGL special.</p>
          </div>
          <div class="hero-media">
            <div class="hero-photo-placeholder">
              <span class="placeholder-icon">🎉</span>
              <div class="placeholder-label">Pupils Participating in Activity</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {featured ? (
      <>
        <!-- FEATURED MOMENT — the most recently published post -->
        <section class="featured-section">
          <div class="container">
            <div class="featured-card" id={featured.slug}>
              <div class="featured-media">
                {featured.imageUrl ? (
                  <img src={featured.imageUrl} alt={featured.title} />
                ) : (
                  <span class="placeholder-icon">{featured.isVideo ? '🎬' : '📸'}</span>
                )}
              </div>
              <div class="featured-content">
                <span class="featured-badge">A day worth remembering ✨</span>
                <h2>{featured.title}</h2>
                <div class="featured-meta">{featured.categoryLabel} · {featured.dateLabel}</div>
                <div>
                  <button class="btn btn-gold" onclick={`openPost('${featured.slug}')`}>View Moment →</button>
                </div>
              </div>
            </div>
          </div>
        </section>

        {gridPosts.length > 0 && (
          <>
            <nav class="category-filter-nav" aria-label="Category filter">
              <div class="container">
                <div class="filter-scroll-row">
                  <button class="filter-btn active" onclick="filterGrid('all', this)">All Moments</button>
                  {LIFE_CATEGORY_OPTIONS.map((cat) => (
                    <button class="filter-btn" onclick={`filterGrid('${cat.value}', this)`}>{cat.label}</button>
                  ))}
                </div>
              </div>
            </nav>

            <section class="container">
              <div class="journal-grid" id="journal-grid">
                {gridPosts.map((post, i) => (
                  <article
                    class={`journal-card ${TONE_CYCLE[i % TONE_CYCLE.length]}`}
                    id={post.slug}
                    data-category={post.category}
                    onclick={`openPost('${post.slug}')`}
                  >
                    <div class="card-media">
                      {post.imageUrl ? (
                        <img src={post.imageUrl} alt={post.title} />
                      ) : (
                        <span class="placeholder-icon">{post.isVideo ? '🎬' : '📸'}</span>
                      )}
                      {post.isVideo && <div class="video-indicator">▶</div>}
                    </div>
                    <div class="card-body">
                      <div class="card-meta-bar">
                        <span class="card-category">{post.categoryLabel}</span>
                        <span class="card-date">{post.dateLabel}</span>
                      </div>
                      <h3 class="card-title">{post.title}</h3>
                      <div class="card-footer">
                        <span class="card-action-text">{post.isVideo ? 'Watch video →' : 'View story →'}</span>
                        <button
                          class="btn-share"
                          onclick={`event.stopPropagation(); shareMoment(${JSON.stringify(post.title)}, '${post.slug}')`}
                        >📲 Share</button>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          </>
        )}
      </>
    ) : (
      <section class="container">
        <div class="empty-life-state">
          <p>New moments from DGL are on their way — check back soon! 🌱</p>
        </div>
      </section>
    )}

    <section class="container">
      <div class="parent-cta-box">
        <h2>Like what you see?</h2>
        <p>Give your child the opportunity to learn, participate and grow at DGL.</p>
        <a href="/#contact" class="btn btn-secondary2">Explore Admissions →</a>
      </div>
    </section>
  </main>

  <div class="modal-overlay" id="postModal" role="dialog" aria-modal="true">
    <button class="modal-nav-btn modal-prev-btn" id="modalPrevBtn" onclick="navigatePost(-1)" aria-label="Previous moment" hidden>&#8249;</button>
    <button class="modal-nav-btn modal-next-btn" id="modalNextBtn" onclick="navigatePost(1)" aria-label="Next moment" hidden>&#8250;</button>
    <div class="modal-container" id="modalContainer">
      <button class="modal-close-btn" onclick="closeModal()" aria-label="Close modal">&times;</button>
      <div class="modal-media-box" id="modalMedia">
        [ Photo / Lightweight YouTube Player Container ]
      </div>
      <button class="modal-rotate-btn" id="modalRotateBtn" onclick="rotateMedia()" aria-label="Rotate photo" hidden>&#8635;</button>
      <div class="modal-caption">
        <h2 class="modal-caption-title" id="modalTitle">Moment Title</h2>
        <div class="modal-caption-meta" id="modalMeta">Category · Session</div>
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="index.html" class="brand" style="color: var(--color-white);">
            <img src="/asset/DGLS-Badge-two-colour.svg" class="brand-badge" alt="DAN-GRACIOUS LAND Badge">
            <div class="brand-text">
              <span class="brand-title" style="color: var(--color-white);">DAN-GRACIOUS LAND</span>
              <span class="brand-subtitle" style="color: rgba(255,255,255,0.7);">Nursery & Primary School</span>
            </div>
          </a>
          <p>More than a school. A place to grow. Serving nursery and primary pupils in Idimu, Lagos State.</p>
        </div>

        <div class="footer-column">
          <h4>Explore</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/pupils">Pupils</a></li>
            <li><a href="/life">Life at DGL</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>School</h4>
          <ul>
            <li><a href="/about">Our Philosophy</a></li>
            <li><a href="/leadership">School Leadership</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>Contact</h4>
          <ul>
            <li><a href={`tel:${phoneSupport}`}>Phone Support</a></li>
            <li><a href={whatsAppChannelLink}>WhatsApp Channel</a></li>
            <li><a href="/#contact">27, Asunbe Street, Idimu</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© <span id="year"></span> Dan-Gracious Land Nursery & Primary School. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="/privacy-policy">Privacy Policy</a>
          <div class="creator-credit">
            Built by <a href="https://emmystack01.com/" target="_blank" rel="noopener" style="color: var(--color-gold); text-decoration: underline;">Emmy STACK01</a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <!-- CMS-sourced post data, rendered as inert JSON (not executed code) so
       the behavioral script below can stay a plain is:inline script. -->
  <script type="application/json" id="posts-data" set:html={JSON.stringify(clientPosts).replace(/</g, '\\u003c')}></script>

  <script src="/asset/script/year.js" is:inline></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Mobile Navigation Menu Toggle
      const mobileBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      const navItems = document.querySelectorAll('.nav-links a');

      mobileBtn.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('active');
        mobileBtn.classList.toggle('active');
        mobileBtn.setAttribute('aria-expanded', isOpen);
      });

      navItems.forEach(item => {
        item.addEventListener('click', () => {
          if (navLinks.classList.contains('active')) {
            navLinks.classList.remove('active');
            mobileBtn.classList.remove('active');
            mobileBtn.setAttribute('aria-expanded', 'false');
          }
        });
      });
    });

    // Category Filtering
    function filterGrid(category, btnElement) {
      const buttons = document.querySelectorAll('.filter-btn');
      buttons.forEach(btn => btn.classList.remove('active'));
      btnElement.classList.add('active');

      const cards = document.querySelectorAll('.journal-card');
      cards.forEach(card => {
        if (category === 'all' || card.getAttribute('data-category') === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Modal Post Detail View
    let currentPostId = '';
    let currentPostTitle = '';
    let currentRotation = 0;
    // The natural pixel dimensions of the currently-open VIDEO's thumbnail
    // (used as a stand-in for the video's own shape), or the 16:9 fallback
    // when there's no thumbnail to measure. Photos don't need this any
    // more — object-fit: contain plus matching max-width/max-height on the
    // <img> itself handles their sizing purely in CSS.
    let currentMediaNaturalWidth = null;
    let currentMediaNaturalHeight = null;

    // Sizes the VIDEO box only. An <iframe> has no intrinsic size the way
    // an <img> does, so its box can't just be handed max-width/max-height
    // and left to fit itself the way a photo can — the actual pixel size
    // has to be computed here, capped at the same 90% of the viewport
    // (desktop) / near-full viewport (mobile) the spec calls for, using
    // whichever of width or height is more restrictive so the video never
    // gets cropped or stretched.
    function sizeModalToMedia() {
      const mediaBox = document.getElementById('modalMedia');
      if (!mediaBox || !mediaBox.classList.contains('is-video')) return;
      if (!currentMediaNaturalWidth || !currentMediaNaturalHeight) return;
      const isMobile = window.innerWidth <= 700;
      const maxWidthPx = isMobile ? window.innerWidth * 0.96 : window.innerWidth * 0.9;
      const maxHeightPx = isMobile ? window.innerHeight * 0.74 : window.innerHeight * 0.82;
      const scale = Math.min(1, maxWidthPx / currentMediaNaturalWidth, maxHeightPx / currentMediaNaturalHeight);
      const displayWidth = Math.round(currentMediaNaturalWidth * scale);
      const displayHeight = Math.round(currentMediaNaturalHeight * scale);
      mediaBox.style.width = Math.max(280, displayWidth) + 'px';
      mediaBox.style.height = displayHeight + 'px';
    }

    // Re-applies the current rotation's sizing (see rotateMedia below) to
    // the open photo, if any. Split out from rotateMedia() so the resize
    // listener can re-fit an already-rotated photo without spinning it
    // further each time the viewport changes.
    function applyImageRotation() {
      const mediaBox = document.getElementById('modalMedia');
      const img = mediaBox ? mediaBox.querySelector('img') : null;
      if (!img || !img.naturalWidth) return;
      if (currentRotation === 0) {
        // Upright — hand sizing back to plain CSS instead of leaving
        // stale inline pixel values behind.
        img.style.maxWidth = '';
        img.style.maxHeight = '';
        img.style.width = '';
        img.style.height = '';
        img.style.transform = '';
        mediaBox.style.width = '';
        mediaBox.style.height = '';
        return;
      }
      const rotated = currentRotation === 90 || currentRotation === 270;
      const isMobile = window.innerWidth <= 700;
      const maxWidthPx = isMobile ? window.innerWidth * 0.96 : window.innerWidth * 0.9;
      const maxHeightPx = isMobile ? window.innerHeight * 0.74 : window.innerHeight * 0.82;
      // Turned on its side, the photo's width/height budgets swap — what
      // the screen's height allowed now bounds its width, and vice versa.
      const widthBudget = rotated ? maxHeightPx : maxWidthPx;
      const heightBudget = rotated ? maxWidthPx : maxHeightPx;
      const scale = Math.min(1, widthBudget / img.naturalWidth, heightBudget / img.naturalHeight);
      const displayWidth = Math.round(img.naturalWidth * scale);
      const displayHeight = Math.round(img.naturalHeight * scale);
      img.style.maxWidth = 'none';
      img.style.maxHeight = 'none';
      img.style.width = displayWidth + 'px';
      img.style.height = displayHeight + 'px';
      img.style.transform = `rotate(${currentRotation}deg)`;
      // The box itself is sized to the ROTATED (swapped) footprint so the
      // caption below sits in the right place and nothing gets clipped.
      mediaBox.style.width = (rotated ? displayHeight : displayWidth) + 'px';
      mediaBox.style.height = (rotated ? displayWidth : displayHeight) + 'px';
    }

    function rotateMedia() {
      currentRotation = (currentRotation + 90) % 360;
      applyImageRotation();
    }

    // Re-fit whenever the viewport changes size (rotation, resizing a
    // desktop window).
    window.addEventListener('resize', () => {
      if (document.getElementById('postModal').classList.contains('open')) {
        sizeModalToMedia();
        applyImageRotation();
      }
    });

    // CMS-sourced posts, read from the JSON data block Astro rendered
    // above. Keyed by the same stable slug used in data-category cards,
    // the featured card, and shareMoment() links — so a shared link
    // (?post=post-3) can open the exact same content the card itself
    // opens, without duplicating post data inside this script. Object.keys
    // preserves the JSON's own order (newest first, same as the cards),
    // which doubles as the prev/next navigation order below.
    const postsDataEl = document.getElementById('posts-data');
    const POSTS = postsDataEl ? JSON.parse(postsDataEl.textContent) : {};

    function openPost(postId) {
      const post = POSTS[postId];
      if (!post) return;
      openModal(post.title, post.meta, post.text, postId, post.videoUrl || null, post.imageUrl || null);
    }

    // Moves to the previous (-1) or next (1) post in display order. No
    // wraparound — the matching arrow simply hides at either end (see
    // updateNavButtons) so it's clear there's nothing further that way.
    function navigatePost(direction) {
      const order = Object.keys(POSTS);
      const idx = order.indexOf(currentPostId);
      if (idx === -1) return;
      const nextIdx = idx + direction;
      if (nextIdx < 0 || nextIdx >= order.length) return;
      openPost(order[nextIdx]);
    }

    function updateNavButtons() {
      const order = Object.keys(POSTS);
      const idx = order.indexOf(currentPostId);
      const prevBtn = document.getElementById('modalPrevBtn');
      const nextBtn = document.getElementById('modalNextBtn');
      if (prevBtn) prevBtn.hidden = idx <= 0;
      if (nextBtn) nextBtn.hidden = idx === -1 || idx >= order.length - 1;
    }

    function openModal(title, meta, text, postId, videoUrl = null, imageUrl = null) {
      currentPostId = postId;
      currentPostTitle = title;
      currentRotation = 0;

      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalMeta').textContent = meta;

      const mediaBox = document.getElementById('modalMedia');
      mediaBox.classList.remove('is-video', 'is-image');
      // Clear any aspect-ratio/size left over from a previous post before
      // this one sets its own (or falls back to defaults) below.
      mediaBox.style.aspectRatio = '';
      mediaBox.style.width = '';
      mediaBox.style.height = '';
      currentMediaNaturalWidth = null;
      currentMediaNaturalHeight = null;

      const rotateBtn = document.getElementById('modalRotateBtn');
      rotateBtn.hidden = true;

      // Built with createElement + real DOM properties rather than an
      // innerHTML template string. A pasted video URL or a post title can
      // contain a stray " character (e.g. copied along with surrounding
      // quotes) — with string-built HTML that silently closes the
      // src="..."/title="..." attribute early and dumps the rest of the
      // tag's attributes onto the page as visible text (exactly the
      // "title="Yo... width="1( ..." leak seen in testing). Property
      // assignment can't be broken out of that way: whatever characters
      // are in the value just become the value, never markup.
      mediaBox.replaceChildren();
      if (videoUrl) {
        // Some embed URLs may already carry query params (e.g. a Vimeo
        // hash param) — appending "?autoplay=1" unconditionally would
        // produce a malformed double-"?" URL that fails to load at all.
        const autoplaySeparator = videoUrl.includes('?') ? '&' : '?';
        mediaBox.classList.add('is-video');
        const iframe = document.createElement('iframe');
        iframe.src = `${videoUrl}${autoplaySeparator}autoplay=1`;
        iframe.title = title;
        iframe.width = '100%';
        iframe.height = '100%';
        iframe.frameBorder = '0';
        iframe.allow = 'autoplay; encrypted-media';
        iframe.allowFullscreen = true;
        mediaBox.appendChild(iframe);
        // Size the box right away from a standard 16:9 assumption so it
        // never depends on flex auto-sizing quirks for an empty box; if
        // this post has an uploaded thumbnail, re-measure against its
        // real shape once it loads — a portrait thumbnail gets a portrait
        // video box, same as an image post would, instead of always
        // being forced widescreen.
        currentMediaNaturalWidth = 1280;
        currentMediaNaturalHeight = 720;
        sizeModalToMedia();
        if (imageUrl) {
          const probe = new Image();
          probe.onload = () => {
            // Guard against a slow-loading thumbnail resolving after the
            // person has closed this post or opened a different one.
            if (mediaBox.classList.contains('is-video') && currentPostId === postId) {
              currentMediaNaturalWidth = probe.naturalWidth;
              currentMediaNaturalHeight = probe.naturalHeight;
              sizeModalToMedia();
            }
          };
          probe.src = imageUrl;
        }
      } else if (imageUrl) {
        mediaBox.classList.add('is-image');
        const img = document.createElement('img');
        img.alt = title;
        img.src = imageUrl;
        mediaBox.appendChild(img);
        rotateBtn.hidden = false;
      } else {
        const placeholder = document.createElement('div');
        placeholder.textContent = `[ Photo View: ${title} ]`;
        mediaBox.appendChild(placeholder);
      }

      updateNavButtons();
      document.getElementById('postModal').classList.add('open');
    }

    function closeModal() {
      const modal = document.getElementById('postModal');
      modal.classList.remove('open');
      document.getElementById('modalMedia').replaceChildren();
    }

    // Deliberately no click-outside-to-close listener here — the user
    // specifically wants only the X button to close this viewer, not a
    // click on the backdrop (easy to trigger by accident while scrolling
    // past the image on a touch screen).

    // Arrow-key navigation (desktop) while the modal is open.
    document.addEventListener('keydown', (e) => {
      if (!document.getElementById('postModal').classList.contains('open')) return;
      if (e.key === 'ArrowLeft') navigatePost(-1);
      else if (e.key === 'ArrowRight') navigatePost(1);
    });

    // Swipe navigation (mobile). Horizontal-only, and requires the swipe
    // to be clearly more horizontal than vertical, so scrolling the
    // caption or an incidental vertical drag never triggers it.
    let modalTouchStartX = 0;
    let modalTouchStartY = 0;
    const modalMediaEl = document.getElementById('modalMedia');
    if (modalMediaEl) {
      modalMediaEl.addEventListener('touchstart', (e) => {
        const t = e.changedTouches[0];
        modalTouchStartX = t.clientX;
        modalTouchStartY = t.clientY;
      }, { passive: true });
      modalMediaEl.addEventListener('touchend', (e) => {
        const t = e.changedTouches[0];
        const dx = t.clientX - modalTouchStartX;
        const dy = t.clientY - modalTouchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          navigatePost(dx < 0 ? 1 : -1);
        }
      }, { passive: true });
    }

    // Web Share API with Link Fallback
    function shareMoment(title, postId) {
      const shareUrl = `${window.location.origin}${window.location.pathname}?post=${postId}`;
      const shareText = `See this moment from Dan-Gracious Land Nursery & Primary School: ${title}! ✨`;

      if (navigator.share) {
        navigator.share({
          title: 'Life at DGL Moment',
          text: shareText,
          url: shareUrl,
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(`${shareText} ${shareUrl}`).then(() => {
          alert('Link copied to clipboard! You can now paste and share it on WhatsApp.');
        });
      }
    }

    // Open the shared post directly when arriving via a copied link
    // (?post=post-1, as generated by shareMoment above). Falls back to
    // a #post-1 hash too, in case a link was shared that way instead.
    (function openSharedPostFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const postId = params.get('post') || window.location.hash.replace('#', '');
      if (postId && POSTS[postId]) {
        openPost(postId);
      }
    })();
  </script>
</body>
</html>
