        </div>

        <div class="achievements-grid" id="achievements-grid">

          {achievementCards.length > 0 ? (
            achievementCards.map((a) => (
              <div class="digital-award-card" id={a.id} data-class={a.classLevel}>
                <div>
                  <span class="award-type-badge">{a.icon} {a.awardTitle}</span>
                  <h3 class="awardee-name">{a.pupilName}</h3>
