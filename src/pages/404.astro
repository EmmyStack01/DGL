---
export const prerender = true;

import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const siteSettings = await reader.singletons.siteSettings.read();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page Not Found | Dan-Gracious Land Nursery & Primary School</title>
  <meta name="description" content="The page you're looking for couldn't be found. Return to the Dan-Gracious Land Nursery & Primary School homepage." />
  <meta name="robots" content="noindex" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">
  <style>
    /* -------------------------------------------------------------------------- */
    /* 1. DESIGN SYSTEM — TOKENS SHARED WITH THE HOMEPAGE                        */
    /* -------------------------------------------------------------------------- */
    :root {
      --color-navy: #0E2154;
      --color-navy-deep: #081533;
      --color-navy-soft: #1C3576;
      --color-cream: #FFF9EC;
      --color-cream-card: #FFFFFF;
      --color-gold: #FFC72C;
      --color-gold-deep: #F2A900;
      --color-gold-light: #FFF1C2;
      --color-orange: #F0640F;
      --color-orange-hover: #D4530A;
      --color-green: #2E9E4F;
      --color-blue: #1F5FD1;
      --color-purple: #6B3FA0;
      --color-red: #C81E2C;
      --color-text-dark: #101B3D;
      --color-text-muted: #5B6280;
      --color-white: #FFFFFF;
      --color-surface-soft: #F4EFE0;
      --color-border: #E7DFC8;

      --font-display: 'Poppins', -apple-system, sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Inter', -apple-system, sans-serif;

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --radius-full: 9999px;

      --shadow-sm: 0 4px 10px -2px rgba(14, 33, 84, 0.10);
      --shadow-md: 0 14px 28px -8px rgba(14, 33, 84, 0.18);
      --shadow-lg: 0 30px 60px -16px rgba(14, 33, 84, 0.30);

      --glass-bg: rgba(14, 33, 84, 0.97);
      --glass-border: rgba(255, 199, 44, 0.25);

      --container-max: 1240px;
      --header-height: 84px;
    }

    /* -------------------------------------------------------------------------- */
    /* 2. RESET & BASE                                                           */
    /* -------------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: var(--font-body);
      background-color: var(--color-cream);
      color: var(--color-text-dark);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; font-size: inherit; cursor: pointer; border: none; background: none; }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1.15;
      color: var(--color-navy);
      letter-spacing: -0.01em;
    }

    main { flex: 1; display: flex; align-items: center; }

    /* -------------------------------------------------------------------------- */
    /* 3. BUTTONS                                                                 */
    /* -------------------------------------------------------------------------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.9rem 2.1rem;
      font-weight: 800;
      font-size: 1rem;
      border-radius: var(--radius-full);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      text-align: center;
      min-height: 52px;
    }

    .btn-primary {
      background-color: var(--color-orange);
      color: var(--color-white);
      box-shadow: 0 10px 22px -6px rgba(240, 100, 15, 0.5);
    }
    .btn-primary:hover {
      background-color: var(--color-orange-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 26px -6px rgba(240, 100, 15, 0.55);
    }

    .btn-outline {
      border: 2.5px solid var(--color-gold);
      color: var(--color-navy);
      background: var(--color-white);
    }
    .btn-outline:hover {
      background-color: var(--color-gold);
      color: var(--color-navy);
      transform: translateY(-3px);
    }

    .btn-gold {
      background-color: var(--color-gold);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(255, 199, 44, 0.55);
    }
    .btn-gold:hover {
      background-color: var(--color-gold-deep);
      transform: translateY(-3px);
    }

    /* Level-color ribbon strip — echoes the flyer's Creche/Nursery/Primary/Secondary bars */
    .level-stripe { display: flex; height: 7px; width: 100%; }
    .level-stripe span { flex: 1; }
    .level-stripe .s-orange { background: var(--color-orange); }
    .level-stripe .s-green { background: var(--color-green); }
    .level-stripe .s-blue { background: var(--color-blue); }
    .level-stripe .s-purple { background: var(--color-purple); }

    /* -------------------------------------------------------------------------- */
    /* 4. HEADER & NAVIGATION                                                     */
    /* -------------------------------------------------------------------------- */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background-color: var(--color-navy);
      height: var(--header-height);
      display: flex;
      align-items: center;
      box-shadow: 0 6px 18px -8px rgba(8, 21, 51, 0.45);
    }

    .header .container { display: flex; align-items: center; justify-content: space-between; }

    .brand { display: flex; align-items: center; gap: 0.85rem; }

    .brand-badge { width: auto; height: 60px; display: flex; align-items: center; justify-content: center; }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.05rem;
      line-height: 1;
      color: var(--color-white);
      letter-spacing: 0.01em;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--color-gold-light);
      font-weight: 600;
      display: block;
      margin-top: 3px;
    }

    .nav-links { display: flex; align-items: center; gap: 2.25rem; list-style: none; }
    .nav-links a { font-weight: 700; font-size: 0.92rem; color: var(--color-white); transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--color-gold); }

    .mobile-menu-btn { display: none; flex-direction: column; gap: 6px; padding: 0.5rem; }
    .mobile-menu-btn span { width: 26px; height: 2.5px; background-color: var(--color-gold); border-radius: 4px; transition: all 0.3s ease; }

    /* -------------------------------------------------------------------------- */
    /* 5. 404 HERO                                                                */
    /* -------------------------------------------------------------------------- */
    .error-section { padding: 4rem 0; width: 100%; }

    .error-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
      align-items: center;
    }

    .error-badge-wrap { position: relative; display: flex; align-items: center; justify-content: center; }

    .error-badge {
      width: 100%;
      max-width: 380px;
      aspect-ratio: 1 / 1;
      border-radius: 50%;
      background: linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
      background-image:
        radial-gradient(circle at 75% 20%, rgba(255, 199, 44, 0.18), transparent 55%),
        linear-gradient(160deg, var(--color-navy) 0%, var(--color-navy-deep) 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-lg);
      border: 6px solid var(--color-gold);
      position: relative;
    }

    .error-number {
      font-family: var(--font-display);
      font-weight: 900;
      font-size: clamp(3.5rem, 9vw, 5.5rem);
      color: var(--color-white);
      line-height: 1;
    }

    .error-emoji { font-size: 2.75rem; margin-top: 0.5rem; }

    .error-pill {
      position: absolute;
      top: -10px;
      right: 4%;
      background: var(--color-gold);
      color: var(--color-navy);
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.4rem 0.95rem;
      border-radius: var(--radius-full);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      box-shadow: var(--shadow-sm);
      transform: rotate(4deg);
    }

    .error-content h1 {
      font-size: clamp(2rem, 4.5vw, 2.75rem);
      margin-bottom: 1rem;
    }

    .error-content p {
      font-size: 1.1rem;
      color: var(--color-text-muted);
      margin-bottom: 2rem;
      max-width: 480px;
      line-height: 1.7;
    }

    .error-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 2.75rem; }

    .quick-links-label {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-navy);
      margin-bottom: 1rem;
    }

    .quick-links-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
      max-width: 480px;
    }

    .quick-link-card {
      background: var(--color-cream-card);
      border-radius: var(--radius-md);
      padding: 1rem 1.2rem;
      box-shadow: var(--shadow-sm);
      border-top: 5px solid var(--color-orange);
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--color-navy);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .quick-link-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }

    .quick-link-card:nth-child(2) { border-top-color: var(--color-green); }
    .quick-link-card:nth-child(3) { border-top-color: var(--color-blue); }
    .quick-link-card:nth-child(4) { border-top-color: var(--color-purple); }

    .quick-link-card span:last-child { color: var(--color-gold-deep); font-size: 1.1rem; }

    /* -------------------------------------------------------------------------- */
    /* 6. FOOTER                                                                  */
    /* -------------------------------------------------------------------------- */
    .footer {
      background-color: var(--color-navy-deep);
      color: var(--color-white);
      padding: 5rem 0 2.5rem 0;
      border-top: 4px solid var(--color-gold);
    }

    .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 3rem; margin-bottom: 4rem; }

    .footer-brand p { color: rgba(255, 255, 255, 0.7); margin-top: 1.25rem; font-size: 0.95rem; max-width: 320px; line-height: 1.6; }

    .footer-column h4 { color: var(--color-gold); font-size: 1.02rem; margin-bottom: 1.5rem; font-weight: 800; }
    .footer-column ul { list-style: none; }
    .footer-column li { margin-bottom: 0.85rem; }
    .footer-column a, .address { color: rgba(255, 255, 255, 0.75); font-size: 0.95rem; transition: color 0.2s; }
    .footer-column a:hover { color: var(--color-gold); }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.6);
    }

    .footer-bottom-links { display: flex; align-items: center; gap: 1.5rem; }
    .footer-bottom a { color: rgba(255, 255, 255, 0.75); transition: color 0.2s; }
    .footer-bottom a:hover { color: var(--color-gold); }

    /* -------------------------------------------------------------------------- */
    /* 7. RESPONSIVE                                                             */
    /* -------------------------------------------------------------------------- */
    @media (max-width: 900px) {
      .error-grid { grid-template-columns: 1fr; text-align: center; }
      .error-badge-wrap { order: -1; }
      .error-content p { margin-left: auto; margin-right: auto; }
      .error-actions { justify-content: center; }
      .quick-links-grid { margin-left: auto; margin-right: auto; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 850px) {
      .nav-links, .header-cta { display: none; }
      .mobile-menu-btn { display: flex; }
      .footer-grid { grid-template-columns: 1fr; }

      .nav-links.active {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: var(--header-height);
        left: 0;
        right: 0;
        background-color: var(--color-navy);
        padding: 1.75rem;
        border-bottom: 3px solid var(--color-gold);
        box-shadow: var(--shadow-md);
        gap: 1.25rem;
        z-index: 999;
      }

      .mobile-menu-btn.active span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
      .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
      .mobile-menu-btn.active span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

      .container { padding: 0 1rem; }

      .footer-bottom { flex-direction: column; text-align: center; gap: 1rem; }
      .footer-bottom-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    }

    @media (max-width: 480px) {
      .footer-grid { grid-template-columns: 1fr; }
      .quick-links-grid { grid-template-columns: 1fr; }
      .error-actions { flex-direction: column; width: 100%; }
      .error-actions .btn { width: 100%; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

  <header class="header">
    <div class="container">
      <a href="/" class="brand">
        <img src="/asset/DGLS-Badge-two-colour.svg" class="brand-badge" alt="DAN-GRACIOUS LAND Badge">
        <div class="brand-text">
          <span class="brand-title">DAN-GRACIOUS LAND</span>
          <span class="brand-subtitle">Nursery & Primary School</span>
        </div>
      </a>

      <nav>
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/pupils">Pupils</a></li>
          <li><a href="/life">Life at DGL</a></li>
        </ul>
      </nav>

      <div class="header-cta">
        <a href="/#contact" class="btn btn-gold">Enquire Now</a>
      </div>

      <button class="mobile-menu-btn" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <div class="level-stripe" aria-hidden="true">
    <span class="s-orange"></span><span class="s-green"></span><span class="s-blue"></span><span class="s-purple"></span>
  </div>

  <main>
    <section class="error-section">
      <div class="container">
        <div class="error-grid">
          <div class="error-badge-wrap">
            <div class="error-badge">
              <span class="error-pill">Lost & Found</span>
              <div class="error-number">404</div>
              <div class="error-emoji">🧭</div>
            </div>
          </div>

          <div class="error-content">
            <h1>This page must be out on the playground.</h1>
            <p>We couldn't find the page you were looking for. It may have moved, been renamed, or never existed in the first place. Let's get you back on track.</p>

            <div class="error-actions">
              <a href="/" class="btn btn-primary">Back to Homepage</a>
              <a href={`tel:${siteSettings.phoneSupport}`} class="btn btn-outline">Contact the School</a>
            </div>

            <div class="quick-links-label">Or try one of these</div>
            <div class="quick-links-grid">
              <a href="/" class="quick-link-card"><span>Home</span><span>→</span></a>
              <a href="/pupils" class="quick-link-card"><span>Pupils</span><span>→</span></a>
              <a href="/life" class="quick-link-card"><span>Life at DGL</span><span>→</span></a>
              <a href="/leadership" class="quick-link-card"><span>Leadership</span><span>→</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="index.html" class="brand" style="color: var(--color-white);">
            <img src="asset/DGLS-Badge-two-colour.svg" class="brand-badge" alt="DAN-GRACIOUS LAND Badge">
            <div class="brand-text">
              <span class="brand-title" style="color: var(--color-white);">DAN-GRACIOUS LAND</span>
              <span class="brand-subtitle" style="color: rgba(255,255,255,0.7);">Nursery & Primary School</span>
            </div>
          </a>
          <p>More than a school. A place to grow. Serving nursery and primary pupils in Idimu, Lagos State.</p>
        </div>

        <div class="footer-column">
          <h4>Explore</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/pupils">Pupils</a></li>
            <li><a href="/life">Life at DGL</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>School</h4>
          <ul>
            <li><a href="/about">Our Philosophy</a></li>
            <li><a href="/leadership">School Leadership</a></li>
          </ul>
        </div>

        <div class="footer-column">
          <h4>Contact</h4>
          <ul>
            <li><a href={`tel:${siteSettings.phoneSupport}`}>Phone Support</a></li>
            <li><a href={siteSettings.whatsAppChannelLink}>WhatsApp Channel</a></li>
            <li><a href="/#contact">27, Asunbe Street, Idimu</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© <span id="year"></span> Dan-Gracious Land Nursery & Primary School. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="/privacy-policy">Privacy Policy</a>
          <div class="creator-credit">
            Built by <a href="https://emmystack01.com/" target="_blank" rel="noopener" style="color: var(--color-gold); text-decoration: underline;">Emmy STACK01</a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <script src="/asset/script/year.js" is:inline></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const mobileBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      const navItems = document.querySelectorAll('.nav-links a');

      mobileBtn.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('active');
        mobileBtn.classList.toggle('active');
        mobileBtn.setAttribute('aria-expanded', isOpen);
      });

      navItems.forEach(item => {
        item.addEventListener('click', () => {
          if (navLinks.classList.contains('active')) {
            navLinks.classList.remove('active');
            mobileBtn.classList.remove('active');
            mobileBtn.setAttribute('aria-expanded', 'false');
          }
        });
      });
    });
  </script>
</body>
</html>
