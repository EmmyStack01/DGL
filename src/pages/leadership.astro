---
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leadership | Dan-Gracious Land Nursery & Primary School</title>
  <meta name="description" content="Meet the leadership team behind Dan-Gracious Land Nursery & Primary School in Idimu, Lagos. Dedicated educators shaping pupil development and excellence." />

  <meta property="og:title" content="Leadership - Dan-Gracious Land Nursery & Primary School" />
  <meta property="og:description" content="Meet the people helping to guide our school, support our pupils and shape the DGL experience." />
  <meta property="og:type" content="website" />

  <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">
  
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    "name": "Dan-Gracious Land Nursery & Primary School",
    "alternateName": "DGL",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "27, Asunbe Street",
      "addressLocality": "Idimu",
      "addressRegion": "Lagos",
      "addressCountry": "NG"
    },
    "url": "https://emmystack01.com"
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800;900&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    /* -------------------------------------------------------------------------- */
    /* 1. DESIGN SYSTEM — TOKENS SHARED WITH THE HOMEPAGE                        */
    /* -------------------------------------------------------------------------- */
    :root {
      --color-navy: #0E2154;
      --color-navy-deep: #081533;
      --color-navy-soft: #1C3576;
      --color-cream: #FFF9EC;
      --color-cream-card: #FFFFFF;
      --color-gold: #FFC72C;
      --color-gold-deep: #F2A900;
      --color-gold-light: #FFF1C2;
      --color-orange: #F0640F;
      --color-orange-hover: #D4530A;
      --color-green: #2E9E4F;
      --color-blue: #1F5FD1;
      --color-purple: #6B3FA0;
      --color-red: #C81E2C;
      --color-text-dark: #101B3D;
      --color-text-muted: #5B6280;
      --color-white: #FFFFFF;
      --color-surface-soft: #F4EFE0;
      --color-border: #E7DFC8;

      --font-display: 'Poppins', -apple-system, sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Inter', -apple-system, sans-serif;

      --radius-sm: 10px;
      --radius-md: 18px;
      --radius-lg: 28px;
      --radius-full: 9999px;

      --shadow-sm: 0 4px 10px -2px rgba(14, 33, 84, 0.10);
      --shadow-md: 0 14px 28px -8px rgba(14, 33, 84, 0.18);
      --shadow-lg: 0 30px 60px -16px rgba(14, 33, 84, 0.30);

      --glass-bg: rgba(14, 33, 84, 0.97);
      --glass-border: rgba(255, 199, 44, 0.25);

      --container-max: 1240px;
      --header-height: 84px;
    }

    /* -------------------------------------------------------------------------- */
    /* 2. RESET & BASE                                                           */
    /* -------------------------------------------------------------------------- */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: var(--font-body);
      background-color: var(--color-cream);
      color: var(--color-text-dark);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; font-size: inherit; cursor: pointer; border: none; background: none; }

    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    h1, h2, h3, h4 {
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1.15;
      color: var(--color-navy);
      letter-spacing: -0.01em;
    }

    .text-center { text-align: center; }

    .section-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.15rem;
      background: var(--color-orange);
      color: var(--color-white);
      font-weight: 800;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border-radius: var(--radius-full);
      margin-bottom: 1rem;
      box-shadow: var(--shadow-sm);
    }
    .section-tag.tag-blue { background: var(--color-blue); }
    .section-tag.tag-purple { background: var(--color-purple); }
    .section-tag.tag-green { background: var(--color-green); }

    .section-title-wrap { max-width: 620px; margin: 0 auto 3rem auto; text-align: center; }
    .section-title-wrap h2 { font-size: clamp(2rem, 4vw, 2.5rem); margin-bottom: 0.5rem; font-weight: 900; }
    .section-title-wrap p { font-size: 1.05rem; color: var(--color-text-muted); }

    /* -------------------------------------------------------------------------- */
    /* 3. BUTTONS                                                                 */
    /* -------------------------------------------------------------------------- */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.9rem 2.1rem;
      font-weight: 800;
      font-size: 1rem;
      border-radius: var(--radius-full);
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      text-align: center;
      min-height: 52px;
    }

    .btn-primary {
      background-color: var(--color-orange);
      color: var(--color-white);
      box-shadow: 0 10px 22px -6px rgba(240, 100, 15, 0.5);
    }
    .btn-primary:hover {
      background-color: var(--color-orange-hover);
      transform: translateY(-3px);
      box-shadow: 0 14px 26px -6px rgba(240, 100, 15, 0.55);
    }

    .btn-secondary {
      background-color: var(--color-navy);
      color: var(--color-white);
      box-shadow: 0 10px 20px -5px rgba(10, 15, 29, 0.3);
    }
    .btn-secondary:hover {
      background-color: var(--color-navy-soft);
      transform: translateY(-3px);
      box-shadow: 0 14px 24px -4px rgba(10, 15, 29, 0.4);
    }

    .btn-secondary2 {
      background-color: var(--color-white);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(0,0,0,0.15);
    }
    .btn-secondary2:hover { transform: translateY(-3px); }

    .btn-outline {
      border: 2.5px solid var(--color-gold);
      color: var(--color-navy);
      background: var(--color-white);
    }
    .btn-outline:hover {
      background-color: var(--color-gold);
      color: var(--color-navy);
      transform: translateY(-3px);
    }

    .btn-gold {
      background-color: var(--color-gold);
      color: var(--color-navy);
      box-shadow: 0 10px 20px -6px rgba(255, 199, 44, 0.55);
    }
    .btn-gold:hover {
      background-color: var(--color-gold-deep);
      transform: translateY(-3px);
    }

    /* Level-color ribbon strip — echoes the flyer's Creche/Nursery/Primary/Secondary bars */
    .level-stripe { display: flex; height: 7px; width: 100%; }
    .level-stripe span { flex: 1; }
    .level-stripe .s-orange { background: var(--color-orange); }
    .level-stripe .s-green { background: var(--color-green); }
    .level-stripe .s-blue { background: var(--color-blue); }
    .level-stripe .s-purple { background: var(--color-purple); }

    /* -------------------------------------------------------------------------- */
    /* 4. HEADER & NAVIGATION                                                     */
    /* -------------------------------------------------------------------------- */
    .header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background-color: var(--color-navy);
      height: var(--header-height);
      display: flex;
      align-items: center;
      box-shadow: 0 6px 18px -8px rgba(8, 21, 51, 0.45);
    }

    .header .container { display: flex; align-items: center; justify-content: space-between; }

    .brand { display: flex; align-items: center; gap: 0.85rem; }

    .brand-badge { width: auto; height: 60px; display: flex; align-items: center; justify-content: center; }

    .brand-title {
      font-family: var(--font-display);
      font-weight: 800;
      font-size: 1.05rem;
      line-height: 1;
      color: var(--color-white);
      letter-spacing: 0.01em;
    }

    .brand-subtitle {
      font-size: 0.72rem;
      color: var(--color-gold-light);
      font-weight: 600;
      display: block;
      margin-top: 3px;
    }

    .nav-links { display: flex; align-items: center; gap: 2.25rem; list-style: none; }
    .nav-links a { font-weight: 700; font-size: 0.92rem; color: var(--color-white); transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--color-gold); }

    .mobile-menu-btn { display: none; flex-direction: column; gap: 6px; padding: 0.5rem; }
    .mobile-menu-btn span { width: 26px; height: 2.5px; background-color: var(--color-gold); border-radius: 4px; transition: all 0.3s ease; }

    /* -------------------------------------------------------------------------- */
    /* 5. BREADCRUMBS                                                            */
    /* -------------------------------------------------------------------------- */
    .breadcrumbs-bar { padding: 1.25rem 0 0.5rem 0; background: var(--color-cream); }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-muted);
      list-style: none;
    }

    .breadcrumbs a { color: var(--color-navy); }
    .breadcrumbs a:hover { color: var(--color-orange); }
    .breadcrumbs li[aria-current] { color: var(--color-orange); font-weight: 800; }

    /* -------------------------------------------------------------------------- */
    /* 6. HERO — centered content, gold pill (matches page-hero pattern)          */
    /* -------------------------------------------------------------------------- */
    .hero-leadership { padding: 2rem 0 3.5rem 0; }

    .hero-content { max-width: 720px; }

    .hero-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background-color: var(--color-gold);
      color: var(--color-navy);
      padding: 0.45rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 800;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-sm);
      width: fit-content;
    }

    .hero-heading {
      font-size: clamp(2.25rem, 4.5vw, 3.25rem);
      margin-bottom: 1rem;
    }

    .hero-subtext {
      font-size: 1.15rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      max-width: 620px;
    }

    /* -------------------------------------------------------------------------- */
    /* 7. LEADERSHIP INTRODUCTION                                                 */
    /* -------------------------------------------------------------------------- */
    .intro-section { margin-bottom: 4rem; }

    .intro-card {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 3rem;
      box-shadow: var(--shadow-sm);
      border-top: 6px solid var(--color-gold);
    }

    .intro-card h2 { font-size: 1.9rem; margin-bottom: 0.85rem; }
    .intro-card p { font-size: 1.05rem; color: var(--color-text-muted); max-width: 850px; }

    /* -------------------------------------------------------------------------- */
    /* 8. FEATURED LEADER SPOTLIGHT — navy gradient panel (matches heart/location) */
    /* -------------------------------------------------------------------------- */
    .featured-leader-section { margin-bottom: 5rem; }

    .featured-card {
      background: var(--color-navy);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,199,44,0.12), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem;
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: 3rem;
      align-items: center;
      position: relative;
      box-shadow: var(--shadow-lg);
      border-top: 6px solid var(--color-gold);
    }

    .featured-portrait-wrap { position: relative; }

    .featured-portrait {
      width: 100%;
      height: 380px;
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1.5rem;
      color: var(--color-navy);
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-md);
    }

    .featured-portrait-icon { font-size: 3.5rem; margin-bottom: 1rem; }

    .featured-portrait-label {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      background: var(--color-navy);
      color: var(--color-white);
      font-family: var(--font-display);
      padding: 0.9rem 1rem;
    }

    .featured-portrait-label strong {
      display: block;
      font-size: 0.85rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
    }

    .featured-portrait-label span {
      display: block;
      font-size: 0.75rem;
      margin-top: 0.15rem;
      color: rgba(255,255,255,0.7);
      text-transform: none;
      letter-spacing: normal;
      font-weight: 500;
    }

    .badge-motif-tag {
      position: absolute;
      top: -14px;
      right: -14px;
      background: var(--color-gold);
      color: var(--color-navy);
      font-size: 0.75rem;
      font-weight: 800;
      padding: 0.45rem 0.9rem;
      border-radius: var(--radius-full);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      box-shadow: var(--shadow-sm);
      z-index: 5;
    }

    .featured-message-label {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-gold);
      font-weight: 800;
      margin-bottom: 0.85rem;
    }

    .featured-content h2 { color: var(--color-white); font-size: 2rem; margin-bottom: 1rem; }

    .featured-quote {
      font-size: 1.1rem;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 1.75rem;
      font-style: normal;
    }

    .featured-meta { border-top: 1px solid rgba(255, 255, 255, 0.15); padding-top: 1.25rem; }

    .featured-name { font-size: 1.35rem; font-weight: 800; color: var(--color-white); }
    .featured-title { font-size: 0.95rem; color: var(--color-gold); font-weight: 600; }

    /* -------------------------------------------------------------------------- */
    /* 9. LEADERSHIP GRID & CARDS — colour-cycling top borders                    */
    /* -------------------------------------------------------------------------- */
    .leadership-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .leader-card {
      background: var(--color-cream-card);
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      border-top: 6px solid var(--color-orange);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .leader-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }

    .leader-card:nth-child(2) { border-top-color: var(--color-green); }
    .leader-card:nth-child(3) { border-top-color: var(--color-blue); }

    .leader-portrait-frame {
      height: 240px;
      background: linear-gradient(160deg, #FFF1C2 0%, #F4EFE0 100%);
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1rem;
      color: var(--color-navy);
    }

    .leader-portrait-label {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      background: var(--color-navy);
      color: var(--color-white);
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.75rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      padding: 0.7rem 0.5rem;
    }

    .leader-role-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: var(--color-gold);
      color: var(--color-navy);
      font-size: 0.75rem;
      font-weight: 800;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-sm);
    }

    .leader-card-body { padding: 1.75rem; display: flex; flex-direction: column; flex-grow: 1; }

    .leader-name { font-size: 1.35rem; margin-bottom: 0.25rem; }

    .leader-position {
      font-size: 0.85rem;
      font-weight: 800;
      color: var(--color-orange);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }
    .leader-card:nth-child(2) .leader-position { color: var(--color-green); }
    .leader-card:nth-child(3) .leader-position { color: var(--color-blue); }

    .leader-bio { font-size: 0.95rem; color: var(--color-text-muted); line-height: 1.6; }

    /* -------------------------------------------------------------------------- */
    /* 10. LEADERSHIP PHILOSOPHY                                                  */
    /* -------------------------------------------------------------------------- */
    .philosophy-section {
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2.5rem;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-sm);
    }

    .philosophy-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-top: 2.5rem;
    }

    .philosophy-item {
      padding: 1.75rem;
      background: var(--color-white);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      border-top: 6px solid var(--color-orange);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .philosophy-item:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }

    .philosophy-item:nth-child(2) { border-top-color: var(--color-green); }
    .philosophy-item:nth-child(3) { border-top-color: var(--color-blue); }
    .philosophy-item:nth-child(4) { border-top-color: var(--color-purple); }

    .philosophy-item h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
    .philosophy-item p { font-size: 0.9rem; color: var(--color-text-muted); }

    /* -------------------------------------------------------------------------- */
    /* 11. CONNECT WITH PUPILS — navy gradient panel (matches "Every Child" block) */
    /* -------------------------------------------------------------------------- */
    .connect-pupils-strip {
      background: var(--color-navy);
      background-image: radial-gradient(circle at 10% 90%, rgba(255,199,44,0.10), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.75rem;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
      position: relative;
      overflow: hidden;
    }

    .connect-pupils-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }

    .connect-pupils-content h2 { color: var(--color-white); font-size: 2.25rem; margin-bottom: 1rem; }
    .connect-pupils-content p { color: rgba(255, 255, 255, 0.82); font-size: 1.05rem; line-height: 1.7; margin-bottom: 1.75rem; }

    .photo-placeholder-box {
      background: rgba(255,255,255,0.06);
      border: 2px dashed rgba(255, 199, 44, 0.35);
      border-radius: var(--radius-md);
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .photo-placeholder-box p { font-size: 1.02rem; color: var(--color-gold); font-weight: 700; margin: 0; }

    /* -------------------------------------------------------------------------- */
    /* 12. LIFE IN ACTION — 4-photo strip (matches homepage collage pattern)      */
    /* -------------------------------------------------------------------------- */
    .life-action-section {
      background: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem;
      margin-bottom: 5rem;
      text-align: center;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--color-border);
    }

    .life-action-section h2 { font-size: clamp(2rem, 4vw, 2.5rem); }
    .life-action-section .life-action-sub { color: var(--color-text-muted); margin-top: 0.5rem; font-size: 1.05rem; }

    .action-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.1rem; margin: 2.25rem 0; }

    .action-card {
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform 0.3s ease;
    }
    .action-card:hover { transform: translateY(-5px); }

    .action-card-photo {
      height: 118px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.75rem;
    }

    .action-card:nth-child(1) .action-card-photo { background: linear-gradient(150deg, #FFD98A, var(--color-orange)); }
    .action-card:nth-child(2) .action-card-photo { background: linear-gradient(150deg, #9BE6B0, var(--color-green)); }
    .action-card:nth-child(3) .action-card-photo { background: linear-gradient(150deg, #A9C4FF, var(--color-blue)); }
    .action-card:nth-child(4) .action-card-photo { background: linear-gradient(150deg, #D3B6F2, var(--color-purple)); }

    .action-card-label {
      background: var(--color-navy);
      color: var(--color-white);
      text-align: center;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 0.55rem 0.5rem;
    }

    /* -------------------------------------------------------------------------- */
    /* 13. ADMISSIONS CTA — orange gradient banner (matches Life at DGL page)     */
    /* -------------------------------------------------------------------------- */
    .parent-cta-box {
      background: var(--color-orange);
      background-image: radial-gradient(circle at 90% 10%, rgba(255,255,255,0.14), transparent 55%);
      color: var(--color-white);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2rem;
      text-align: center;
      margin-bottom: 5rem;
      box-shadow: var(--shadow-lg);
    }

    .parent-cta-box h2 { color: var(--color-white); font-size: clamp(1.75rem, 4vw, 2.25rem); margin-bottom: 0.5rem; }
    .parent-cta-box p { font-size: 1.1rem; color: rgba(255, 255, 255, 0.92); margin-bottom: 1.75rem; max-width: 560px; margin-left: auto; margin-right: auto; }

    /* -------------------------------------------------------------------------- */
    /* 14. FOOTER                                                                 */
    /* -------------------------------------------------------------------------- */
    .footer {
      background-color: var(--color-navy-deep);
      color: var(--color-white);
      padding: 5rem 0 2.5rem 0;
      border-top: 4px solid var(--color-gold);
    }

    .footer-grid { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: 3rem; margin-bottom: 4rem; }

    .footer-brand p { color: rgba(255, 255, 255, 0.7); margin-top: 1.25rem; font-size: 0.95rem; max-width: 320px; line-height: 1.6; }

    .footer-column h4 { color: var(--color-gold); font-size: 1.02rem; margin-bottom: 1.5rem; font-weight: 800; }
    .footer-column ul { list-style: none; }
    .footer-column li { margin-bottom: 0.85rem; }
    .footer-column a, .address { color: rgba(255, 255, 255, 0.75); font-size: 0.95rem; transition: color 0.2s; }
    .footer-column a:hover { color: var(--color-gold); }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 2rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.6);
    }

    .footer-bottom-links { display: flex; align-items: center; gap: 1.5rem; }
    .footer-bottom a { color: rgba(255, 255, 255, 0.75); transition: color 0.2s; }
    .footer-bottom a:hover { color: var(--color-gold); }

    /* -------------------------------------------------------------------------- */
    /* 15. RESPONSIVE                                                            */
    /* -------------------------------------------------------------------------- */
    @media (max-width: 992px) {
      .featured-card { grid-template-columns: 1fr; padding: 2.25rem; }
      .featured-portrait { height: 300px; }
      .connect-pupils-grid { grid-template-columns: 1fr; gap: 2.5rem; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
      .connect-pupils-strip, .life-action-section { padding: 2.25rem 1.25rem; }
    }

    @media (max-width: 850px) {
      .nav-links, .header-cta { display: none; }
      .mobile-menu-btn { display: flex; }
      .footer-grid { grid-template-columns: 1fr; }

      .nav-links.active {
        display: flex;
        flex-direction: column;
        position: absolute;
        top: var(--header-height);
        left: 0;
        right: 0;
        background-color: var(--color-navy);
        padding: 1.75rem;
        border-bottom: 3px solid var(--color-gold);
        box-shadow: var(--shadow-md);
        gap: 1.25rem;
        z-index: 999;
      }

      .mobile-menu-btn.active span:nth-child(1) { transform: translateY(8.5px) rotate(45deg); }
      .mobile-menu-btn.active span:nth-child(2) { opacity: 0; }
      .mobile-menu-btn.active span:nth-child(3) { transform: translateY(-8.5px) rotate(-45deg); }

      .container { padding: 0 1rem; }

      .footer-bottom { flex-direction: column; text-align: center; gap: 1rem; }
      .footer-bottom-links { flex-wrap: wrap; justify-content: center; gap: 1rem; }
    }

    @media (max-width: 680px) {
      .footer-grid { grid-template-columns: 1fr; }
      .intro-card, .philosophy-section { padding: 1.75rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body>

