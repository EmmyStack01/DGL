          <div class="creator-credit">
            Built by <a href="https://emmystack01.com/" target="_blank" rel="noopener" style="color: var(--color-gold); text-decoration: underline;">Emmy STACK01</a>
          </div>
        </div>
      </div>
    </div>
  </footer>

  <script src="/asset/script/year.js" is:inline></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Mobile Navigation Toggle
      const mobileBtn = document.querySelector('.mobile-menu-btn');
      const navLinks = document.querySelector('.nav-links');
      const navItems = document.querySelectorAll('.nav-links a');

      mobileBtn.addEventListener('click', () => {
        const isOpen = navLinks.classList.toggle('active');
        mobileBtn.classList.toggle('active');
        mobileBtn.setAttribute('aria-expanded', isOpen);
      });

      navItems.forEach(item => {
        item.addEventListener('click', () => {
          if (navLinks.classList.contains('active')) {
            navLinks.classList.remove('active');
            mobileBtn.classList.remove('active');
            mobileBtn.setAttribute('aria-expanded', 'false');
          }
        });
      });
    });

    // Native Web Share API with Clipboard Fallback
    function shareAchievement(awardTitle, sectionId) {
      const shareUrl = `${window.location.origin}${window.location.pathname}#${sectionId}`;
      const shareText = `See this pupil achievement at Dan-Gracious Land Nursery & Primary School: ${awardTitle}! 🎉`;

      if (navigator.share) {
        navigator.share({
          title: 'DGL Pupil Achievement',
          text: shareText,
          url: shareUrl,
        }).catch(() => {
          // Fallback if user cancels
        });
      } else {
        // Fallback for desktop browsers without Web Share API
        navigator.clipboard.writeText(`${shareText} ${shareUrl}`).then(() => {
          alert('Link copied to clipboard! You can now paste and share it on WhatsApp.');
        });
      }
    }

    // Filter Achievements by Class Dropdown
    const classFilterSelect = document.getElementById('achievement-class-filter');
    const awardCards = document.querySelectorAll('.digital-award-card');
    const noAchievementsMsg = document.getElementById('no-achievements-msg');

    function filterAchievements(selectedClass) {
      let anyVisible = false;
      awardCards.forEach(card => {
        const cardClass = card.getAttribute('data-class');
        if (cardClass === selectedClass) {
          card.style.display = 'flex';
          anyVisible = true;
        } else {
          card.style.display = 'none';
        }
      });
      // This element is always in the DOM (rendered server-side either as
      // the "no achievements at all yet" message or the per-class one) —
      // just toggle its visibility based on whether the current filter
      // matched anything.
      if (noAchievementsMsg) {
        noAchievementsMsg.style.display = anyVisible ? 'none' : 'block';
      }
    }

    // Jump to a shared achievement link (e.g. pupils.html#award-pri1-1st).
    // Every class except the default (Creche) is hidden via display:none on
    // load, so the browser's native anchor-scroll can't reach a card from
    // another class — this switches the filter to that card's class first,
    // then scrolls to it and briefly highlights it.
    function goToSharedAchievement() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return false;

      const targetCard = document.getElementById(hash);
      if (!targetCard || !targetCard.classList.contains('digital-award-card')) return false;

      const targetClass = targetCard.getAttribute('data-class');

      if (classFilterSelect) {
        classFilterSelect.value = targetClass;
      }
      filterAchievements(targetClass);

      // Wait a frame so the card is actually visible (display: flex) before
      // asking the browser to scroll to it.
      requestAnimationFrame(() => {
        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        targetCard.classList.add('award-highlight');
        setTimeout(() => targetCard.classList.remove('award-highlight'), 2200);
      });

      return true;
    }

    if (classFilterSelect) {
      // If the URL points to a specific achievement, show its class instead
      // of always defaulting to Creche.
      const jumpedToSharedAchievement = goToSharedAchievement();

      if (!jumpedToSharedAchievement) {
        // Default state on page load (Creche)
        filterAchievements(classFilterSelect.value);
      }

      // Filter on dropdown change
      classFilterSelect.addEventListener('change', (e) => {
        filterAchievements(e.target.value);
      });
    }

    // Keep working if the hash changes without a full page reload
    window.addEventListener('hashchange', goToSharedAchievement);
  </script>
</body>
